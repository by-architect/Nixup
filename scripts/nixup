#!/usr/bin/env bash
# nixup: Nixup on a PC, step by step: a menu that makes a phone's config from the phone (its apps and settings, then
# questions about what a phone cannot tell: updates, access, services, backups, Nix packages, each looked up first as
# the phone gets it, and a Google Play sign-in for the account's token), changes a config by asking again, builds a
# config on a phone (on this computer, or on the phone itself) and takes the phone back to an earlier generation. Each
# step says what it does, and what it would change is shown before anything changes. A config is any module file
# (configuration.nix, a host's default.nix, …), alone or one of a flake's configurations (with other machines in it,
# shared modules, secrets): it is read as a build reads it, through the flake, so what other files set and what the
# Nixup its flake.lock pins has not got are seen, and left as they are.
#
#   nixup                the menu
#   nixup create         make a config from a phone
#   nixup edit           change a config by answering questions
#   nixup build          build a config on a phone (or a dry run: what it would change)
#   nixup generations    the phone's generations, and going back to one
#   nixup play           sign in to Google Play, for the config's token
# Its questions are asked on the terminal, with the keys each takes under it; Enter takes the one in brackets, and in a
# list q goes back. The same work without questions, for scripts, is nixup-config, nixup-rebuild and nixup-play-login,
# which it runs. Needs adb, and nix to make, change or build a config here (a build on the phone needs no nix here).
# NO_COLOR=1: no colors.
set -euo pipefail

usage() { sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | sed '$d; s/^# \{0,1\}//'; }

# Nixup's own files: the scripts next to this one, and nix/ next to their folder (in its repository, its flake's copy,
# or the package's share/nixup).
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
nixup_dir="$(cd "$here/.." && pwd)"

action="${1:-menu}"
case $action in
  menu | create | edit | build | generations | play) ;;
  -h | --help | help) usage; exit 0 ;;
  *) echo "nixup: no such step: $action (create, edit, build, generations, play; --help says more)" >&2; exit 1 ;;
esac
if [[ -x /system/bin/getprop ]]; then
  echo "nixup: this is a phone; nixup runs on a computer, with the phone over adb (here: the Nixup app, or su -c nixup-rebuild)" >&2
  exit 1
fi

# --- The terminal. What nixup shows goes to stderr, and its questions are read from the terminal; NIXUP_TTY is a file
# of answers instead, one a line (for tests), which turns the arrow keys off.
tty_in=${NIXUP_TTY:-/dev/tty}
if ! { : < "$tty_in"; } 2> /dev/null; then
  echo "nixup: it asks its questions on a terminal, and there is none here (nixup-config and nixup-rebuild need none)" >&2
  exit 1
fi
# (Read through one descriptor, 3, so that a file of answers goes on where it was.)
exec 3< "$tty_in"
live=0 fancy=0
[[ $tty_in != /dev/tty ]] || live=1
if ((live)) && [[ -t 2 && ${TERM:-dumb} != dumb ]]; then fancy=1; fi
c_b="" c_d="" c_r="" c_acc="" c_ok="" c_warn="" c_err=""
if [[ -t 2 && -z ${NO_COLOR:-} && ${TERM:-dumb} != dumb ]]; then
  c_b=$'\e[1m' c_d=$'\e[2m' c_r=$'\e[0m' c_acc=$'\e[36m' c_ok=$'\e[32m' c_warn=$'\e[33m' c_err=$'\e[31m'
fi
# Its symbols, or plain ones where the terminal shows no UTF-8.
case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
  *[Uu][Tt][Ff]-8* | *[Uu][Tt][Ff]8*)
    s_ok=✔ s_no=✘ s_warn=! s_dot=● s_ring=○ s_arrow=❯ s_q=◆ s_bar=┃ s_h=─ s_v=│ s_tl=╭ s_bl=╰ s_skip=– s_keys=↑↓ ;;
  *) s_ok=+ s_no=x s_warn=! s_dot='*' s_ring=. s_arrow='>' s_q='?' s_bar='|' s_h=- s_v='|' s_tl=+ s_bl=+ s_skip=- s_keys=up/down ;;
esac
# Its width, kept between 60 and 100 columns.
COLS="$({ stty size < /dev/tty; } 2> /dev/null | cut -d' ' -f2 || true)"
[[ $COLS =~ ^[0-9]+$ ]] || COLS=${COLUMNS:-80}
((COLS <= 100)) || COLS=100
((COLS >= 60)) || COLS=60

say() { printf '%s\n' "$*" >&2; }
# An error that ends the step it happens in (each step of the menu runs on its own: the menu comes back).
die() { printf '\n  %s%s %s%s\n' "$c_err" "$s_no" "$*" "$c_r" >&2; exit 1; }
ok() { printf '  %s%s%s %s\n' "$c_ok" "$s_ok" "$c_r" "$*" >&2; }
warn() { printf '  %s%s%s %s\n' "$c_warn" "$s_warn" "$c_r" "$*" >&2; }
bad() { printf '  %s%s%s %s\n' "$c_err" "$s_no" "$c_r" "$*" >&2; }
# Words that explain, dim, wrapped to the terminal and indented ($2 spaces, 4 by default).
note() {
  local pad line
  printf -v pad '%*s' "${2:-4}" ''
  while IFS= read -r line; do
    printf '%s%s%s%s\n' "$pad" "$c_d" "$line" "$c_r" >&2
  done < <(printf '%s\n' "$1" | fold -s -w $((COLS - ${2:-4} - 2)) | sed 's/ *$//')
}
rule() { local s; printf -v s '%*s' "$1" ''; printf '%s' "${s// /$s_h}"; }
pretty() { local p=$1; [[ $p != "$HOME" && $p != "$HOME"/* ]] || p="~${p#"$HOME"}"; printf '%s' "$p"; }
# What a command says, indented under the step that runs it.
indent() { local line; while IFS= read -r line; do printf '    %s%s%s %s\n' "$c_d" "$s_v" "$c_r" "$line" >&2; done; }

banner() {
  if ((fancy)); then printf '\e[H\e[2J' >&2; fi
  say ""
  say "  ${c_acc}${c_b}Nixup${c_r}  ${c_acc}$(rule $((COLS - 11)))${c_r}"
  say "  ${c_d}A phone set up from a config: make one from the phone, change it, build it.${c_r}"
  say ""
}
# step <n> <of> <title>: the step the flow (FLOW) is at, with a dot for each of its steps.
step() {
  local i dots=""
  for ((i = 1; i <= $2; i++)); do
    if ((i < $1)); then dots+="${c_ok}${s_dot}${c_r}"; elif ((i == $1)); then dots+="${c_acc}${s_dot}${c_r}"; else dots+="${c_d}${s_ring}${c_r}"; fi
  done
  say ""
  say "  ${dots}  ${c_d}${FLOW} · step $1 of $2${c_r}"
  say "  ${c_acc}${s_bar}${c_r} ${c_b}$3${c_r}"
  say ""
}
# A part of the questions: its title, and what it is about.
page() {
  say ""
  say "  ${c_acc}${s_bar} ${c_b}$1${c_r}"
  note "$2"
}
panel() { say "  ${c_acc}${s_tl}${s_h}${c_r} ${c_b}$1${c_r}"; }
row() { say "  ${c_acc}${s_v}${c_r} $*"; }
kv() { local k; printf -v k '%-11s' "$1"; say "  ${c_acc}${s_v}${c_r} ${c_d}${k}${c_r} $2"; }
panel_end() { say "  ${c_acc}${s_bl}${s_h}${c_r}"; }
yes_mark() { if [[ $1 == yes ]]; then printf '%s%s%s' "$c_ok" "$s_ok" "$c_r"; else printf '%s%s%s' "$c_err" "$s_no" "$c_r"; fi; }

# --- Questions.

# menu <title> <item>...: the item picked, by its key, in PICKED ("back" for q, Esc or 0). Each item is
# "key|label|what it does". In a terminal: the arrows (or j and k) and Enter, or an item's number.
menu() {
  local title=$1 item rest i n sel=0 lw=0 k more
  shift
  local -a keys=() labels=() descs=()
  for item in "$@"; do
    keys+=("${item%%|*}")
    rest=${item#*|}
    labels+=("${rest%%|*}")
    descs+=("${rest#*|}")
  done
  n=${#keys[@]}
  for i in "${!labels[@]}"; do ((${#labels[i]} <= lw)) || lw=${#labels[i]}; done
  [[ -z $title ]] || say "  ${c_b}${title}${c_r}"
  if ((fancy)); then
    printf '\e[?25l' >&2
    menu_draw 0
    while :; do
      k=""
      IFS= read -rsn1 k <&3 || k=q
      case $k in
        $'\e')
          more=""
          IFS= read -rsn2 -t 0.05 more <&3 || true
          case $more in
            '[A' | OA) sel=$(((sel + n - 1) % n)) ;;
            '[B' | OB) sel=$(((sel + 1) % n)) ;;
            '') PICKED=back; break ;;
          esac ;;
        k) sel=$(((sel + n - 1) % n)) ;;
        j) sel=$(((sel + 1) % n)) ;;
        '') PICKED=${keys[sel]}; break ;;
        q | 0) PICKED=back; break ;;
        [1-9])
          if ((k <= n)); then
            sel=$((k - 1)) PICKED=${keys[k - 1]}
            menu_draw 1
            break
          fi ;;
      esac
      menu_draw 1
    done
    printf '\e[?25h' >&2
  else
    for i in "${!keys[@]}"; do
      printf -v item "%-${lw}s" "${labels[i]}"
      say "    $((i + 1))  ${item}  ${c_d}${descs[i]}${c_r}"
    done
    while :; do
      printf '    %s[1-%d, q: back]%s %s›%s ' "$c_d" "$n" "$c_r" "$c_acc" "$c_r" >&2
      k=""
      IFS= read -r k <&3 || k=q
      typed "$k"
      case $k in
        q | 0) PICKED=back; break ;;
        '') PICKED=${keys[0]}; break ;;
      esac
      if [[ $k =~ ^[0-9]+$ ]] && ((k >= 1 && k <= n)); then PICKED=${keys[k - 1]}; break; fi
      say "    Type a number from 1 to $n (q: back)."
    done
  fi
}
# The menu's items, the one at sel marked (menu's own variables); with 1, over the last drawing.
menu_draw() {
  local i lab desc avail
  if (($1)); then printf '\e[%dA' $((n + 1)) >&2; fi
  avail=$((COLS - lw - 12))
  ((avail >= 10)) || avail=10
  for i in "${!keys[@]}"; do
    printf -v lab "%-${lw}s" "${labels[i]}"
    desc=${descs[i]}
    ((${#desc} <= avail)) || desc="${desc:0:avail-1}…"
    if ((i == sel)); then
      printf '\r\e[2K  %s%s %s%d  %s%s  %s%s%s\n' "$c_acc" "$s_arrow" "$c_b" $((i + 1)) "$lab" "$c_r" "$c_acc" "$desc" "$c_r" >&2
    else
      printf '\r\e[2K    %s%d%s  %s  %s%s%s\n' "$c_d" $((i + 1)) "$c_r" "$lab" "$c_d" "$desc" "$c_r" >&2
    fi
  done
  printf '\r\e[2K    %s%s move · Enter pick · 1-%d · q back%s\n' "$c_d" "$s_keys" "$n" "$c_r" >&2
}

# key <keys> <default> <choices>: one of keys, pressed (Enter: default), in KEY; the choices are shown first.
key() {
  local k
  printf '    %s %s›%s ' "$3" "$c_acc" "$c_r" >&2
  while :; do
    k=""
    if ((live)); then IFS= read -rsn1 k <&3 || k=$2; else IFS= read -r k <&3 || k=$2; k=${k:0:1}; fi
    [[ -n $k ]] || k=$2
    k=${k,,}
    [[ $k == [[:alnum:]] && $1 == *"$k"* ]] && break
  done
  KEY=$k
}
# The answer, at the end of the question's line.
answered() { say "${c_b}$1${c_r}"; }
# What was typed, when it came from a file of answers (a terminal shows it as it is typed).
typed() { ((live)) || say "${c_d}${1}${c_r}"; }
# ask <question> [default] [shown]: a line typed (Enter: the default, shown in brackets as shown), in ANSWER.
ask() {
  local shown=${3-${2:-}}
  printf '    %s%s %s›%s ' "$1" "${shown:+ ${c_d}[$shown]${c_r}}" "$c_acc" "$c_r" >&2
  ANSWER=""
  IFS= read -r ANSWER <&3 || true
  typed "$ANSWER"
  [[ -n $ANSWER ]] || ANSWER=${2:-}
}
# secret <question>: a line typed and not shown, in ANSWER.
secret() {
  printf '    %s %s›%s ' "$1" "$c_acc" "$c_r" >&2
  ANSWER=""
  if ((live)); then IFS= read -rs ANSWER <&3 || true; say "${c_d}(hidden)${c_r}"; else IFS= read -r ANSWER <&3 || true; typed "(hidden)"; fi
}
# confirm <question> <y|n>: true for yes.
confirm() {
  printf '    %s%s%s\n' "$c_b" "$1" "$c_r" >&2
  key yn "$2" "${c_acc}y${c_r} yes  ${c_acc}n${c_r} no  ${c_d}(Enter: $2)${c_r}"
  if [[ $KEY == y ]]; then answered yes; return 0; fi
  answered no
  return 1
}
pause() {
  printf '\n  %s%s%s ' "$c_d" "${1:-Enter: back to the menu}" "$c_r" >&2
  IFS= read -r REPLY <&3 || true
  typed ""
}
# question <title> <what it is about> [now]: a question's head; its answer is asked under it.
question() {
  say ""
  say "  ${c_acc}${s_q}${c_r} ${c_b}$1${c_r}"
  note "$2"
  [[ -z ${3:-} ]] || say "    ${c_d}now:${c_r} $3"
}
# eds [key label]: enable, disable or skip (Enter), or the other answer given; in KEY.
eds() {
  local allowed=eds choices="${c_acc}e${c_r} enable  ${c_acc}d${c_r} disable"
  if [[ -n ${1:-} ]]; then allowed+=$1 choices+="  ${c_acc}$1${c_r} $2"; fi
  choices+="  ${c_acc}s${c_r} skip ${c_d}(Enter)${c_r}"
  key "$allowed" s "$choices"
  case $KEY in
    e) answered "${c_ok}enable" ;;
    d) answered "${c_warn}disable" ;;
    s) answered "${c_d}skip: left as it is" ;;
    *) answered "$2" ;;
  esac
}

# --- What the menu's steps share (each runs on its own, so it goes through a file): the phone and the config folder.
WORK="$(mktemp -d)"
PHONE_SERIAL="" PHONE_MODEL="" PHONE_ANDROID="" PHONE_NAME="" PHONE_APP="" PHONE_ROOT="" PHONE_MODULE=""
PHONE_PENDING="" PHONE_SOURCE="" PHONE_GEN="" PHONE_REMOTE="" CONFIG_PATH=""
state_vars=(PHONE_SERIAL PHONE_MODEL PHONE_ANDROID PHONE_NAME PHONE_APP PHONE_ROOT PHONE_MODULE PHONE_PENDING PHONE_SOURCE
  PHONE_GEN PHONE_REMOTE CONFIG_PATH)
save_state() {
  local v
  for v in "${state_vars[@]}"; do printf '%s=%s\n' "$v" "${!v//$'\n'/ }"; done > "$WORK/state"
}
load_state() {
  local k v
  [[ -f $WORK/state ]] || return 0
  while IFS='=' read -r k v; do
    case " ${state_vars[*]} " in *" $k "*) printf -v "$k" '%s' "$v" ;; esac
  done < "$WORK/state"
}
cleanup() {
  if ((fancy)); then printf '\e[?25h' >&2; fi
  rm -rf "$WORK"
}
trap cleanup EXIT
# Ctrl-C ends the step it is pressed in (back to the menu), or nixup itself at the menu.
in_step=0
interrupted() {
  if ((fancy)); then printf '\e[?25h' >&2; stty echo icanon < /dev/tty 2> /dev/null || true; fi
  if ((!in_step)); then say ""; exit 130; fi
}
trap interrupted INT

# The config folder of the last time, kept as lib-phone.sh keeps the phone's address.
phone_state="${XDG_CONFIG_HOME:-$HOME/.config}/nixup"

need() { command -v "$1" > /dev/null || die "there is no $1 here: $2"; }
with_timeout() { if command -v timeout > /dev/null; then timeout "$@"; else shift; "$@"; fi; }

# --- Nix. nixx: with the new commands; NIXPKGS: -I nixpkgs=… when NIX_PATH has none (as nixup-config finds it).
nixx() { nix --extra-experimental-features 'nix-command flakes' "$@"; }
NIXPKGS=()
nixpkgs_found=0
find_nixpkgs() {
  ((nixpkgs_found)) && return 0
  nix-instantiate --find-file nixpkgs > /dev/null 2>&1 || NIXPKGS=(-I nixpkgs=flake:nixpkgs)
  nixpkgs_found=1
}
# A value in Nix: a string, quoted.
nix_str() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//\$\{/\\\$\{}
  printf '"%s"' "$s"
}
# Names as Nix writes them, joined by dots: quoted where they are not plain names, or are Nix's own words.
nix_attrpath() {
  local name out=""
  for name in "$@"; do
    if [[ $name =~ ^[A-Za-z_][A-Za-z0-9_\'-]*$ ]] && [[ ! " if then else assert with let in rec inherit or " == *" $name "* ]]; then
      out+=".$name"
    else
      out+=".$(nix_str "$name")"
    fi
  done
  printf '%s' "${out#.}"
}

# --- The phone, through adb (lib-phone.sh: phone_connect, phone_root, ...).
# shellcheck source=lib-phone.sh
source "$here/lib-phone.sh"

# The phones adb sees and can use: PHONES (one seen over USB and the network is one, by USB), PHONE_MODELS, PHONE_HOW;
# WAITING: those whose screen asks to allow USB debugging.
phones_seen() {
  local s id model
  local -a seen=()
  local -A by_id=()
  PHONES=() PHONE_MODELS=() PHONE_HOW=() WAITING=""
  command -v adb > /dev/null || return 0
  mapfile -t seen < <(adb devices 2> /dev/null | awk 'NR > 1 && $2 == "device" { print $1 }')
  for s in "${seen[@]}"; do
    id="$(adb -s "$s" shell getprop ro.serialno < /dev/null 2> /dev/null | tr -d '\r' || true)"
    id=${id:-$s}
    [[ -n ${by_id[$id]:-} && ${by_id[$id]} != *:* ]] || by_id[$id]=$s
  done
  mapfile -t PHONES < <(printf '%s\n' "${by_id[@]}" | grep . | sort || true)
  for s in "${PHONES[@]}"; do
    model="$(adb -s "$s" shell getprop ro.product.model < /dev/null 2> /dev/null | tr -d '\r' || true)"
    PHONE_MODELS+=("${model:-a phone}")
    if [[ $s == *:* ]]; then PHONE_HOW+=(network); else PHONE_HOW+=(USB); fi
  done
  WAITING="$(adb devices 2> /dev/null | awk 'NR > 1 && $2 == "unauthorized" { print $1 }' | tr '\n' ' ' || true)"
  WAITING=${WAITING% }
}
adb_sees() { adb devices 2> /dev/null | awk 'NR > 1 && $2 == "device" { print $1 }' | grep -qxF "$1"; }

# What the phone says without root (its model, Android, name, Nixup's app), then with root (Nixup's module, the config
# it builds, its generation).
phone_facts() {
  local out k v
  out="$(adb -s "$PHONE_SERIAL" shell -T 'echo "model=$(getprop ro.product.model)"; echo "android=$(getprop ro.build.version.release)"; echo "name=$(settings get global device_name)"; echo "app=$(dumpsys package dev.nixup.manager 2> /dev/null | sed -n "s/^ *versionName=//p" | head -n 1)"' < /dev/null 2> /dev/null | tr -d '\r' || true)"
  PHONE_MODEL="" PHONE_ANDROID="" PHONE_NAME="" PHONE_APP=""
  while IFS='=' read -r k v; do
    case $k in model) PHONE_MODEL=$v ;; android) PHONE_ANDROID=$v ;; name) PHONE_NAME=$v ;; app) PHONE_APP=$v ;; esac
  done <<< "$out"
  [[ $PHONE_NAME != null ]] || PHONE_NAME=""
  say "  ${c_d}Asking ${PHONE_MODEL:-the phone} for root (if Magisk asks on its screen, allow Shell)…${c_r}"
  local facts='echo "root=$(id -u)"; d=/data/adb/modules_update/nixup; [ -f $d/module.prop ] || d=/data/adb/modules/nixup
echo "module=$(sed -n "s/^version=//p" $d/module.prop 2> /dev/null)"
[ -d /data/adb/modules_update/nixup ] && echo pending=yes
[ -f $d/remote.sh ] && echo remote=yes
echo "source=$(head -n 1 /data/adb/nixup/source 2> /dev/null)"
echo "generation=$(cat /data/adb/nixup/generations/last 2> /dev/null)"'
  out="$(with_timeout 60 adb -s "$PHONE_SERIAL" shell -T "su -c $(phone_quote "$facts")" < /dev/null 2> /dev/null | tr -d '\r' || true)"
  PHONE_ROOT=no PHONE_MODULE="" PHONE_PENDING="" PHONE_SOURCE="" PHONE_GEN="" PHONE_REMOTE=""
  while IFS='=' read -r k v; do
    case $k in
      root) [[ $v != 0 ]] || PHONE_ROOT=yes ;;
      module) PHONE_MODULE=$v ;;
      pending) PHONE_PENDING=$v ;;
      remote) PHONE_REMOTE=$v ;;
      source) PHONE_SOURCE=$v ;;
      generation) PHONE_GEN=$v ;;
    esac
  done <<< "$out"
  save_state
}

# The phone's panel (the menu's, and a step's).
phone_rows() {
  local how=USB
  [[ $PHONE_SERIAL != *:* ]] || how=network
  if [[ -z $PHONE_SERIAL ]]; then
    phones_seen
    case ${#PHONES[@]} in
      0) kv Phone "${c_d}${s_ring} none: plug one in with USB debugging on${WAITING:+ (one waits for you to allow it on its screen)}${c_r}" ;;
      1) kv Phone "${c_d}${s_ring} not picked yet (adb sees ${PHONE_MODELS[0]})${c_r}" ;;
      *) kv Phone "${c_d}${s_ring} not picked yet (adb sees ${#PHONES[@]} phones)${c_r}" ;;
    esac
    return 0
  fi
  if ! adb_sees "$PHONE_SERIAL"; then
    kv Phone "${c_warn}${s_dot}${c_r} ${PHONE_MODEL:-the phone} ($PHONE_SERIAL) ${c_warn}is not connected now${c_r}"
    return 0
  fi
  kv Phone "${c_ok}${s_dot}${c_r} ${c_b}${PHONE_MODEL:-a phone}${c_r}${PHONE_NAME:+ \"$PHONE_NAME\"} · Android ${PHONE_ANDROID:-?} · $how ($PHONE_SERIAL)"
  if [[ $PHONE_ROOT != yes ]]; then
    kv "" "root $(yes_mark no) ${c_d}(Magisk → Superuser: allow Shell, then pick the phone again)${c_r}"
  elif [[ -z $PHONE_MODULE ]]; then
    kv "" "root $(yes_mark yes) · Nixup's module $(yes_mark no) ${c_d}(install it in Magisk, from Nixup's releases)${c_r}"
  else
    kv "" "root $(yes_mark yes) · Nixup $PHONE_MODULE $(yes_mark yes)${PHONE_PENDING:+ ${c_warn}(an update waits for a restart)${c_r}} · generation ${PHONE_GEN:-none yet}"
    if [[ -n $PHONE_SOURCE ]]; then kv "" "${c_d}builds${c_r} $PHONE_SOURCE"; else kv "" "${c_d}builds no config yet${c_r}"; fi
  fi
}

# Which phone: picked from the ones adb sees, or one connected over the network. Status 1: none (q).
pick_phone() {
  local i last
  local -a items=()
  while :; do
    phones_seen
    items=()
    for i in "${!PHONES[@]}"; do items+=("p$i|${PHONE_MODELS[i]}|${PHONES[i]}, over ${PHONE_HOW[i]}"); done
    last="$(cat "$phone_state/address" 2> /dev/null || true)"
    items+=("net|Connect over the network|adb over Wi-Fi or Tailscale${last:+ (last time: $last)}")
    items+=("again|Look again|after plugging a phone in, or allowing USB debugging on it")
    [[ -z $WAITING ]] || warn "$WAITING waits for you: allow USB debugging on its screen, then Look again."
    if ((${#PHONES[@]} == 0)); then
      note "adb sees no phone. Plug it in with USB debugging on (Settings → Developer options), or connect it over the network: Nixup's adb port (android.adb.port), or Developer options → Wireless debugging." 2
    fi
    menu "Which phone?" "${items[@]}"
    case $PICKED in
      back) return 1 ;;
      again) continue ;;
      net)
        ask "The phone's address (host or ip, with :port)" "$last"
        [[ -n $ANSWER ]] || continue
        phone_connect "$ANSWER"
        break ;;
      p*) PHONE_SERIAL=${PHONES[${PICKED#p}]}; break ;;
    esac
  done
  phone_facts
}

# The phone for a step: the one picked (if adb still sees it), else asked; with root and Nixup's module, when $1 is
# module.
ensure_phone() {
  need adb "android-tools (on NixOS: nix shell nixpkgs#android-tools)"
  if [[ -n $PHONE_SERIAL ]] && adb_sees "$PHONE_SERIAL"; then
    panel "The phone"
    phone_rows
    panel_end
    menu "" "keep|Use this phone|" "other|Pick another phone|"
    case $PICKED in
      back) return 1 ;;
      other) pick_phone || return 1 ;;
    esac
  else
    pick_phone || return 1
  fi
  [[ ${1:-} != module ]] || require_module
  ok "${PHONE_MODEL:-The phone} ($PHONE_SERIAL)"
}
# A build needs root on the phone, and Nixup's module.
require_module() {
  [[ $PHONE_ROOT == yes ]] || die "no root through adb on ${PHONE_MODEL:-the phone}: in Magisk open Superuser, allow Shell, and pick the phone again"
  [[ -n $PHONE_MODULE ]] || die "${PHONE_MODEL:-the phone} has no Nixup module: install it in Magisk (nixup-v<version>.zip from Nixup's releases) and restart the phone"
}

# A command as root on the phone, from the newest Nixup module (the update waiting for a restart, else the running
# one, in $d), with what it says shown as it comes.
module_run() {
  phone_root "d=/data/adb/modules_update/nixup; [ -f \$d/build.sh ] || d=/data/adb/modules/nixup; [ -f \$d/build.sh ] || exit 3; $1"
}

# --- The config: a module file of any name (configuration.nix, a host's default.nix, …), or a folder with one, and the
# flake it is part of, when it is.

# full_path <typed>: a typed path as a whole one (~ and relative paths too), without . and .. in it.
full_path() {
  local p=$1 part
  local -a parts=() kept=()
  # shellcheck disable=SC2088 # (the ~ typed, as it is)
  [[ $p != "~" && $p != "~/"* ]] || p=$HOME${p#\~}
  [[ $p == /* ]] || p=$PWD/$p
  IFS=/ read -ra parts <<< "$p"
  for part in "${parts[@]}"; do
    case $part in
      "" | .) ;;
      ..) if ((${#kept[@]})); then unset 'kept[${#kept[@]}-1]'; fi ;;
      *) kept+=("$part") ;;
    esac
  done
  printf '/%s' "$(IFS=/; printf '%s' "${kept[*]}")"
}
# The config nixup starts with: this folder, when it has a configuration.nix or a flake.nix; else the last one.
first_config() {
  local last
  if [[ -f $PWD/configuration.nix || -f $PWD/flake.nix ]]; then printf '%s' "$PWD"; return 0; fi
  last="$(cat "$phone_state/config" 2> /dev/null || cat "$phone_state/config-folder" 2> /dev/null || true)"
  if [[ -n $last && -e $last ]]; then printf '%s' "$last"; fi
  return 0
}
remember_config() { mkdir -p "$phone_state" && printf '%s\n' "$1" > "$phone_state/config"; }
config_row() {
  local p=$CONFIG_PATH f
  local -a what=()
  if [[ -z $p ]]; then kv Config "${c_d}${s_ring} none picked yet${c_r}"; return 0; fi
  if [[ -f $p ]]; then kv Config "${c_ok}${s_dot}${c_r} $(pretty "$p")"; return 0; fi
  for f in configuration.nix default.nix flake.nix; do [[ ! -f $p/$f ]] || what+=("$f"); done
  if ((${#what[@]})); then kv Config "${c_ok}${s_dot}${c_r} $(pretty "$p") ${c_d}(${what[*]})${c_r}"
  else kv Config "${c_warn}${s_dot}${c_r} $(pretty "$p") ${c_d}(no config in it yet)${c_r}"; fi
}

# The configurations a flake.nix names (nixupConfigurations.<name> = …), as written (when Nix cannot be asked).
flake_names() {
  grep -v '^[[:space:]]*#' "$1" | grep -oE '(nixup|seraph)Configurations\.("[^"]+"|[A-Za-z0-9_-]+)' \
    | sed -E 's/^[a-z]+Configurations\.//; s/^"(.*)"$/\1/' | sort -u || true
}
# The commit and day a flake.lock pins Nixup at.
lock_line() {
  local out rev t day
  command -v nix > /dev/null || return 0
  out="$(NIXUP_LOCK="$1" nixx eval --raw --impure --expr 'let l = builtins.fromJSON (builtins.readFile (builtins.getEnv "NIXUP_LOCK")); i = l.nodes.root.inputs.nixup or null; n = if builtins.isString i then l.nodes.${i}.locked or null else null; in if n == null then "" else "${n.rev or "-"} ${toString (n.lastModified or 0)}"' 2> /dev/null || true)"
  [[ -n $out ]] || return 0
  read -r rev t <<< "$out"
  day="$(date -d "@$t" +%F 2> /dev/null || date -r "$t" +%F 2> /dev/null || true)"
  printf 'Nixup at %s%s' "${rev:0:7}" "${day:+, $day}"
}
# The files a config's file names (./tailscale.key, ../../modules/ssh.nix), past its comments.
named_files() {
  sed -e 's/^[[:space:]]*#.*$//' -e 's/[[:space:]]#.*$//' "$1" | grep -oE '(^|[^A-Za-z0-9_.~/-])\.\.?/[A-Za-z0-9._+/-]+' \
    | sed -E 's/^[^.]//' | sort -u || true
}

# resolve_config <path>: the config at a path typed: the file (any .nix but flake.nix: configuration.nix, a host's
# default.nix), or a folder's (its configuration.nix, else its default.nix, else its other .nix file, asked when there
# are several), and the flake it is part of: a flake.nix of Nixup's in its folder or one above it, as far as the top of
# its git repository. Sets CFG_FILE (none for a flake.nix given alone), CFG_DIR, and of the flake: CFG_FLAKE, CFG_ROOT,
# CFG_REF (as Nix fetches it: git+file:… with its submodules, or path:…), CFG_CLI (as nixup-rebuild --flake takes it),
# CFG_REL (the file in it), CFG_PHONES (its nixupConfigurations), CFG_NIXUP (the Nixup its flake.lock pins) and CFG_NAME
# (the configuration made from the file). Status 1: no config there.
resolve_config() {
  local p=$1 f d top levels=0 name seg machine="" hostname="" item
  local -a files=() segs=() q=() items=()
  CFG_FILE="" CFG_DIR="" CFG_FLAKE="" CFG_ROOT="" CFG_REF="" CFG_CLI="" CFG_REL="" CFG_NIXUP="" CFG_NAME=""
  CFG_PHONES=() CFG_MACHINES=()
  if [[ -f $p ]]; then
    CFG_DIR="$(dirname "$p")"
    if [[ $(basename "$p") == flake.nix ]]; then CFG_FLAKE=$p; else CFG_FILE=$p; fi
  elif [[ -d $p ]]; then
    CFG_DIR=$p
    for f in configuration.nix default.nix; do
      if [[ -f $p/$f ]]; then CFG_FILE=$p/$f; break; fi
    done
    if [[ -z $CFG_FILE && ! -f $p/flake.nix ]]; then
      mapfile -t files < <(find "$p" -maxdepth 1 -type f -name '*.nix' | sort)
      ((${#files[@]})) || return 1
      if ((${#files[@]} == 1)); then
        CFG_FILE=${files[0]}
      else
        for f in "${files[@]}"; do items+=("$f|$(basename "$f")|$(wc -l < "$f") lines"); done
        menu "Which of them is the config?" "${items[@]}"
        [[ $PICKED != back ]] || return 1
        CFG_FILE=$PICKED
      fi
    fi
  else
    return 1
  fi

  # The flake it is part of.
  top="$(git -C "$CFG_DIR" rev-parse --show-toplevel 2> /dev/null || true)"
  d=$CFG_DIR
  while :; do
    if [[ -f $d/flake.nix ]] && grep -qE 'nixupConfigurations|seraphConfigurations|nixupSystem|seraphSystem' "$d/flake.nix"; then
      CFG_FLAKE=$d/flake.nix
      break
    fi
    if [[ -n $top ]]; then [[ $d != "$top" ]] || break
    else levels=$((levels + 1)); ((levels < 4)) || break; fi
    [[ $d != / ]] || break
    d="$(dirname "$d")"
  done
  [[ -n $CFG_FLAKE ]] || return 0
  CFG_ROOT="$(dirname "$CFG_FLAKE")"
  top="$(git -C "$CFG_ROOT" rev-parse --show-toplevel 2> /dev/null || true)"
  CFG_CLI=$CFG_ROOT
  if [[ -n $top ]]; then
    CFG_REF="git+file://$top"
    [[ $top == "$CFG_ROOT" ]] || q+=("dir=${CFG_ROOT#"$top"/}")
    if [[ -f $top/.gitmodules ]]; then q+=(submodules=1); CFG_CLI+="?submodules=1"; fi
    ((${#q[@]} == 0)) || CFG_REF+="?$(IFS='&'; printf '%s' "${q[*]}")"
  else
    CFG_REF="path:$CFG_ROOT"
  fi
  [[ -z $CFG_FILE || $CFG_FILE != "$CFG_ROOT"/* ]] || CFG_REL=${CFG_FILE#"$CFG_ROOT"/}

  # Its phones and machines, as Nix evaluates the flake (its names may be made, as one for each host's folder).
  flake_info
  [[ -n $CFG_FILE ]] || return 0
  ((${#CFG_PHONES[@]})) || return 0
  [[ -n $CFG_REL ]] || return 0
  # The configuration made from the file: one named as a folder on its way, or as the file (hosts/samsung/default.nix:
  # samsung), else as its networking.hostName, else the only one; else asked. One of the flake's NixOS machines' is not
  # a phone's.
  IFS=/ read -ra segs <<< "${CFG_REL%.nix}"
  for name in "${CFG_PHONES[@]}"; do
    for seg in "${segs[@]}"; do [[ $name != "$seg" ]] || CFG_NAME=$name; done
  done
  if [[ -z $CFG_NAME ]]; then
    for name in "${CFG_MACHINES[@]}"; do
      for seg in "${segs[@]}"; do [[ $name != "$seg" ]] || machine=$name; done
    done
    [[ -z $machine ]] || die "$(pretty "$CFG_FILE") is $machine's, one of the flake's NixOS machines (nixosConfigurations), not a phone's: nixup works on phones' configs, the flake's nixupConfigurations (${CFG_PHONES[*]})"
    hostname="$(sed -n 's/^[[:space:]]*networking\.hostName[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$CFG_FILE" | head -n 1)"
    for name in "${CFG_PHONES[@]}"; do [[ $name != "$hostname" ]] || CFG_NAME=$name; done
  fi
  if [[ -z $CFG_NAME ]] && ((${#CFG_PHONES[@]} == 1)); then CFG_NAME=${CFG_PHONES[0]}; fi
  if [[ -z $CFG_NAME ]]; then
    items=()
    for name in "${CFG_PHONES[@]}"; do items+=("$name|$name|${CFG_CLI}#$name"); done
    items+=("-|None of them|the file alone, with Nixup's options (its flake's arguments are not there then)")
    menu "Which of the flake's phones is made from $(basename "$CFG_FILE")?" "${items[@]}"
    case $PICKED in back) return 1 ;; -) ;; *) CFG_NAME=$PICKED ;; esac
  fi
  return 0
}
# flake_info: CFG_PHONES, CFG_MACHINES and CFG_NIXUP of the flake at CFG_REF, from Nix (else the names as written).
flake_info() {
  local out kind rest
  if command -v nix > /dev/null; then
    say "  ${c_d}Asking the flake for its phones (Nix evaluates it: the first time, it may fetch its inputs)…${c_r}"
    out="$(NIXUP_HELPER="$here/nixup.nix" NIXUP_REF="$CFG_REF" nixx eval --raw --impure --expr \
      'import (builtins.getEnv "NIXUP_HELPER") { info = true; flakeRef = builtins.getEnv "NIXUP_REF"; }' 2> "$WORK/info.err" || true)"
  fi
  while IFS=$'\t' read -r kind rest; do
    case $kind in
      phones) read -ra CFG_PHONES <<< "$rest" ;;
      machines) read -ra CFG_MACHINES <<< "$rest" ;;
      nixup) CFG_NIXUP=$rest ;;
    esac
  done <<< "${out:-}"
  if [[ -z ${out:-} ]]; then
    mapfile -t CFG_PHONES < <(flake_names "$CFG_FLAKE")
    warn "Nix could not evaluate the flake here$(err_line "$WORK/info.err"): its phones are read from flake.nix as written."
  fi
}
# err_line <file>: ": " and Nix's error in it, its last line, when it has one.
err_line() {
  local e
  e="$(sed -n 's/^ *error: //p' "$1" 2> /dev/null | tail -n 1)"
  [[ -z $e ]] || printf ' (%s)' "$e"
}

# pick_config <question> <default>: the config typed (a file, or a folder with one), resolved; kept for the menu's
# other steps.
pick_config() {
  local p
  ask "$1" "$2" "$(pretty "$2")"
  p="$(full_path "$ANSWER")"
  [[ -e $p ]] || die "there is no $(pretty "$p")"
  resolve_config "$p" || die "there is no config in $(pretty "$p"): no configuration.nix, default.nix, flake.nix or other .nix file"
  CONFIG_PATH=$p
  save_state
  remember_config "$p"
}

# stage_for <file>: where the file is changed while the questions are asked, in STAGE: a folder of this run's that
# stands for the file's own, every file and folder around it a link to the real one (up to its flake's top, or as far
# up as the file's ../ paths reach), so that the copy reads the same files by its relative paths (../../modules/ssh.nix,
# ./secret.key) as the file does, and nothing is written next to the config before you say so (a synced or git folder
# sees nothing of it).
stage_for() {
  local file=$1 dir root rel part here there up=0 n
  dir="$(dirname "$file")"
  if [[ -n $CFG_ROOT && $dir == "$CFG_ROOT"* ]]; then
    root=$CFG_ROOT
  else
    root=$dir
    if [[ -f $file ]]; then
      while IFS= read -r rel; do
        n=0
        while [[ $rel == ../* ]]; do n=$((n + 1)); rel=${rel#../}; done
        ((n <= up)) || up=$n
      done < <(named_files "$file")
    fi
    while ((up > 0)) && [[ $root != / ]]; do root="$(dirname "$root")"; up=$((up - 1)); done
  fi
  rel=${dir#"$root"}
  rel=${rel#/}
  here=$WORK/stage-$BASHPID
  rm -rf "$here"
  mkdir -p "$here"
  there=$root
  while :; do
    link_all "$there" "$here" "${rel%%/*}"
    [[ -n $rel ]] || break
    part=${rel%%/*}
    if [[ $rel == */* ]]; then rel=${rel#*/}; else rel=""; fi
    here=$here/$part there=$there/$part
    mkdir -p "$here"
  done
  STAGE=$here/.$(basename "$file").nixup
}
# link_all <folder> <into> <but>: a link in <into> to each of the folder's files and folders, but the one named <but>.
link_all() {
  local e
  [[ -d $1 ]] || return 0
  for e in "$1"/* "$1"/.[!.]* "$1"/..?*; do
    [[ -e $e || -L $e ]] || continue
    [[ -z $3 || $(basename "$e") != "$3" ]] || continue
    ln -s "$e" "$2/$(basename "$e")"
  done
}

# tracked <file>: git tracks the file (in one of the repository's submodules too), as a flake of it sees it.
tracked() {
  local top file
  top="$(git -C "$CFG_DIR" rev-parse --show-toplevel 2> /dev/null)" || return 1
  file="$(full_path "$1")"
  [[ $file == "$top"/* ]] || return 1
  [[ -n $(git -C "$top" ls-files --recurse-submodules -- "${file#"$top"/}" 2> /dev/null | head -n 1) ]]
}

# look_config: what the config is (resolve_config's), and what a build of it needs, in a panel.
look_config() {
  local lines made lock git_root f rel state missing=0 untracked=0 outside=0
  local -a files=() shown=()
  git_root="$(git -C "$CFG_DIR" rev-parse --show-toplevel 2> /dev/null || true)"
  panel "The config: $(pretty "${CFG_FILE:-$CFG_FLAKE}")"
  if [[ -n $CFG_FILE ]]; then
    lines=$(wc -l < "$CFG_FILE")
    made="$(sed -n 's/^# This phone.s config, made by `nixup-config create` from \(.*\) (.*/made from \1/p; 3q' "$CFG_FILE" | head -n 1)"
    kv "file" "${c_ok}${s_ok}${c_r} $(basename "$CFG_FILE") · $((lines)) lines${made:+ · $made}"
  fi
  if [[ -n $CFG_FLAKE ]]; then
    if [[ -n $CFG_NAME ]]; then
      kv "flake" "${c_ok}${s_ok}${c_r} $(pretty "$CFG_ROOT") · it makes ${c_b}$CFG_NAME${c_r}$( ((${#CFG_PHONES[@]} < 2)) || printf ' (its phones: %s)' "${CFG_PHONES[*]}")"
    elif ((${#CFG_PHONES[@]})); then
      kv "flake" "${c_ok}${s_ok}${c_r} $(pretty "$CFG_ROOT") · its phones: ${CFG_PHONES[*]}$(named_after)"
    else
      kv "flake" "${c_ok}${s_ok}${c_r} $(pretty "$CFG_ROOT") ${c_d}(its phones are found when it is built)${c_r}"
    fi
    if [[ -f $CFG_ROOT/flake.lock ]]; then
      lock="$(lock_line "$CFG_ROOT/flake.lock")"
      kv flake.lock "${c_ok}${s_ok}${c_r} ${lock:-there}"
    else
      kv flake.lock "${c_d}${s_ring} none yet: the first build pins its inputs${c_r}"
    fi
  fi
  if [[ -n $git_root ]]; then
    state="$(git -C "$CFG_DIR" status --porcelain -- . 2> /dev/null | wc -l || true)"
    kv git "${c_ok}${s_ok}${c_r} in $(pretty "$git_root")$( ((state == 0)) || printf ' · %d changes not committed here' "$state")"
  fi
  # The files it names: there, and (for a flake in git) seen by the flake, which sees only what git tracks.
  if [[ -n $CFG_FILE ]]; then
    mapfile -t files < <(named_files "$CFG_FILE")
    for rel in "${files[@]}"; do
      f=$CFG_DIR/$rel
      [[ $rel != ../* ]] || outside=1
      if [[ ! -e $f ]]; then
        shown+=("${c_err}${rel} ${s_no} missing${c_r}"); missing=$((missing + 1))
      elif [[ -n $CFG_FLAKE && -n $git_root ]] && ! tracked "$f"; then
        shown+=("${c_warn}${rel} ${s_warn} not in git${c_r}"); untracked=$((untracked + 1))
      else
        shown+=("${rel} ${c_ok}${s_ok}${c_r}")
      fi
    done
    if ((${#shown[@]})); then kv "files" "${shown[*]}"; fi
    if [[ -n $CFG_FLAKE && -n $git_root ]] && ! tracked "$CFG_FILE"; then
      untracked=$((untracked + 1))
      kv "" "${c_warn}${s_warn} $(basename "$CFG_FILE") is not in git${c_r}"
    fi
  fi
  [[ -z $PHONE_SOURCE ]] || kv "the phone" "${c_d}builds${c_r} $PHONE_SOURCE"
  panel_end
  CFG_OUTSIDE=$outside
  ((missing == 0)) || warn "A file the config names is missing: a build stops on it. Put it there, or take it out of the config."
  ((untracked == 0)) || note "A flake in a git repository sees only the files git tracks: git add them first (and keep a repository with secrets in it private)." 4
  if [[ -n $CFG_FLAKE && -n $CFG_FILE && -z $CFG_NAME ]] && ((${#CFG_PHONES[@]})); then
    note "(The file is changed alone, with Nixup's options: none of the flake's phones is made from it.)" 4
  fi
}
# " (… is named after this phone)", when one of CFG_PHONES is the phone's device name, as nixup-rebuild picks it.
named_after() {
  local name
  [[ -n $PHONE_NAME ]] || return 0
  for name in "${CFG_PHONES[@]}"; do
    if [[ $name == "$PHONE_NAME" ]]; then printf ' %s(%s is named after this phone)%s' "$c_d" "$name" "$c_r"; return 0; fi
  done
}

# --- Changing a configuration.nix. Each answer changes its option where the file writes it, or adds the option
# inside the set it belongs to (else at the end of the file's set); nothing else in the file changes, and the change is
# shown before it is saved. nixup.nix says where Nix found each option (what the file says is not guessed from its text).

# The plan: what the answers change, in their order. PLAN_OP is set (the option gets PLAN_VALUE, Nix's text) or add
# (PLAN_VALUE goes into its list; a list the file has not got yet is made with PLAN_NEW before it, like "with pkgs; ",
# and the items of one list together); PLAN_PATH its names, split by spaces;
# PLAN_NOTE a comment for a line nixup adds; PLAN_SAY the answer in words, for the review. PLAN_FILES: files written
# next to the config (secrets, readable by you alone), each with its text in PLAN_FILE_FROM.
plan_reset() { PLAN_OP=() PLAN_PATH=() PLAN_VALUE=() PLAN_NEW=() PLAN_NOTE=() PLAN_SAY=() PLAN_FILES=() PLAN_FILE_FROM=(); }
plan_set() {
  missing_option "$1" || return 0
  PLAN_OP+=(set) PLAN_PATH+=("$1") PLAN_VALUE+=("$2") PLAN_NEW+=("") PLAN_NOTE+=("$3") PLAN_SAY+=("$4")
}
plan_add() {
  missing_option "$1" || return 0
  PLAN_OP+=(add) PLAN_PATH+=("$1") PLAN_VALUE+=("$2") PLAN_NEW+=("$3") PLAN_NOTE+=("$4") PLAN_SAY+=("$5")
}
# missing_option <path>: false (said) when the Nixup the config is built with has not got the option, which a line
# for it would break the build on (its flake.lock pins an older one): it is left out.
missing_option() {
  local -a names
  if [[ -n ${QIDX[$1]:-} ]] && ! has_option "$1"; then
    read -ra names <<< "$1"
    note "($(nix_attrpath "${names[@]}") is not in the Nixup this config is built with${CFG_NIXUP:+ ($CFG_NIXUP)}: left out.)"
    return 1
  fi
}
plan_file() {
  local from
  from="$(mktemp "$WORK/file.XXXXXX")"
  printf '%s\n' "$2" > "$from"
  PLAN_FILES+=("$1") PLAN_FILE_FROM+=("$from")
}
# plan_file_copy <name> <file>: a file made already (the Google Play token of a sign-in), written next to the config.
plan_file_copy() { PLAN_FILES+=("$1") PLAN_FILE_FROM+=("$2"); }
plan_reset

declare -A PLACE=() SRC_COUNT=() SRC_IDS=() QIDX=() SIBLING=()
VKIND=() VTEXT=() SOURCES=() SHAPE=other FORM=short
# places <file> <path>...: where the file writes each path (names split by spaces) and what it gives it, from
# nixup.nix: PLACE["<i> <depth>"] (line and column), VKIND[i], VTEXT[i], SIBLING[i] (where the last binding of an
# unwritten path's set starts); SHAPE; SOURCES, SRC_COUNT, SRC_IDS (its lists of android.packages).
places() {
  local file=$1 p name json="[" out kind a b c d
  shift
  for p in "$@"; do
    json+="["
    for name in $p; do json+="$(nix_str "$name"),"; done
    json="${json%,}],"
  done
  printf '%s' "${json%,}]" > "$WORK/paths.json"
  find_nixpkgs
  out="$(NIXUP_HELPER="$here/nixup.nix" NIXUP_FILE="$file" NIXUP_PATHS="$WORK/paths.json" nixx eval "${NIXPKGS[@]}" --raw --impure --expr \
    'import (builtins.getEnv "NIXUP_HELPER") { file = builtins.getEnv "NIXUP_FILE"; pathsFile = builtins.getEnv "NIXUP_PATHS"; }' \
    2> "$WORK/places.err")" || {
    bad "Nix could not read $(pretty "$file"):"
    sed -n '/error:/,$p' "$WORK/places.err" | grep -v '^ *… while' | head -n 12 | indent
    return 1
  }
  PLACE=() VKIND=() VTEXT=() SOURCES=() SRC_COUNT=() SRC_IDS=() SIBLING=() SHAPE=other FORM=short
  while IFS=$'\t' read -r kind a b c d; do
    case $kind in
      shape) SHAPE=$a ;;
      form) FORM=$a ;;
      at) PLACE["$a $b"]="$c $d" ;;
      value) VKIND[a]=$b VTEXT[a]=${c:-} ;;
      source) SOURCES+=("$a") SRC_COUNT[$a]=$b SRC_IDS[$a]=${c:-} ;;
      sibling) SIBLING[$a]="$b $c" ;;
    esac
  done <<< "$out"
}

# check_config <file> <missing ok: yes|no> <path>...: the file parses, and each path evaluates with Nixup's options
# (with the config's other definitions of it); with yes, a path the config has no value at is no error. In a flake's
# configuration (CFG_NAME) it is the flake's, with the file (CFG_REL) replaced by <file>, as a build of the changed
# flake has it (none: the flake as it is); else the file alone. Status 3: it does not parse; 1: a path does not
# evaluate (Nix's error in $WORK/check.err either way, for check_error).
check_config() {
  local file=$1 missing=false p name json="[" pkgs=false
  [[ $2 != yes ]] || missing=true
  shift 2
  if [[ -n $file ]]; then nix-instantiate --parse "$file" > /dev/null 2> "$WORK/check.err" || return 3; fi
  for p in "$@"; do
    json+="["
    for name in $p; do json+="$(nix_str "$name"),"; done
    json="${json%,}],"
    [[ $p != "environment systemPackages" ]] || pkgs=true
  done
  printf '%s' "${json%,}]" > "$WORK/check.json"
  if [[ -n $CFG_NAME ]]; then
    NIXUP_HELPER="$here/nixup.nix" NIXUP_FILE="$file" NIXUP_PATHS="$WORK/check.json" NIXUP_REF="$CFG_REF" NIXUP_NAME="$CFG_NAME" \
      NIXUP_REL="$CFG_REL" nixx eval --raw --impure --expr \
      "import (builtins.getEnv \"NIXUP_HELPER\") { file = builtins.getEnv \"NIXUP_FILE\"; pathsFile = builtins.getEnv \"NIXUP_PATHS\"; check = true; flakeRef = builtins.getEnv \"NIXUP_REF\"; configName = builtins.getEnv \"NIXUP_NAME\"; relFile = builtins.getEnv \"NIXUP_REL\"; missingOk = $missing; }" \
      > /dev/null 2> "$WORK/check.err"
    return
  fi
  # (nixpkgs as a folder, read without the store's daemon or writing to it, where it can be found so)
  find_nixpkgs
  local -a look=(nixx eval "${NIXPKGS[@]}")
  if nixpkgs_path; then look=(nix_lookup -I nixpkgs="$NIXPKGS_PATH"); fi
  NIXUP_HELPER="$here/nixup.nix" NIXUP_FILE="$file" NIXUP_PATHS="$WORK/check.json" NIXUP_DIR="$nixup_dir" "${look[@]}" \
    --raw --impure --expr "import (builtins.getEnv \"NIXUP_HELPER\") { file = builtins.getEnv \"NIXUP_FILE\"; pathsFile = builtins.getEnv \"NIXUP_PATHS\"; check = true; nixupDir = builtins.getEnv \"NIXUP_DIR\"; withPkgs = $pkgs; missingOk = $missing; }" \
    > /dev/null 2> "$WORK/check.err"
}
check_error() { sed -n '/error:/,$p' "$WORK/check.err" | grep -v '^ *… while\|^ *(stack trace' | head -n 14 | indent; }

# The file's text, as bytes (the editing below runs with LC_ALL=C), in ED; each line's first byte in LINE_AT.
top_header="# ==== Answers to nixup's questions (nix run github:by-architect/Nixup#nixup) "
re_ident="^[A-Za-z_][A-Za-z0-9_'-]*"
re_qname='^"(([^"\\$]|\\.|\$[^{])*)"'

# ed_skip <byte>: past spaces, newlines and comments, in AT.
ed_skip() {
  local i=$1 c rest
  while :; do
    c=${ED:i:1}
    case $c in
      ' ' | $'\t' | $'\n' | $'\r') i=$((i + 1)) ;;
      '#') rest=${ED:i}; rest=${rest%%$'\n'*}; i=$((i + ${#rest})) ;;
      /)
        [[ ${ED:i:2} == '/*' ]] || break
        rest=${ED:i+2}
        [[ $rest == *'*/'* ]] || return 1
        rest=${rest%%'*/'*}
        i=$((i + 4 + ${#rest})) ;;
      *) break ;;
    esac
  done
  AT=$i
}
# ed_names <byte>: the attribute path of the binding there, in NAMES, and AT just past its "=".
ed_names() {
  local i=$1 rest q
  NAMES=()
  while :; do
    ed_skip "$i" || return 1
    i=$AT
    rest=${ED:i:400}
    if [[ $rest =~ $re_ident ]]; then
      NAMES+=("${BASH_REMATCH[0]}")
      i=$((i + ${#BASH_REMATCH[0]}))
    elif [[ $rest =~ $re_qname ]]; then
      q=${BASH_REMATCH[1]}
      q=${q//\\\"/\"}
      q=${q//\\\$/\$}
      NAMES+=("${q//\\\\/\\}")
      i=$((i + ${#BASH_REMATCH[0]}))
    else
      return 1
    fi
    ed_skip "$i" || return 1
    i=$AT
    case ${ED:i:1} in
      .) i=$((i + 1)) ;;
      =) AT=$((i + 1)); return 0 ;;
      *) return 1 ;;
    esac
  done
}
# ed_scan <byte> <char>: to the first <char> (";") outside strings, comments and brackets, in AT.
ed_scan() {
  local i=$1 c top
  local -a stack=()
  while :; do
    c=${ED:i:1}
    [[ -n $c ]] || return 1
    top=""
    ((${#stack[@]} == 0)) || top=${stack[${#stack[@]}-1]}
    case $top in
      s)
        case $c in
          \\) i=$((i + 2)); continue ;;
          '"') unset "stack[${#stack[@]}-1]" ;;
          '$') if [[ ${ED:i+1:1} == '{' ]]; then stack+=(a); i=$((i + 2)); continue; fi ;;
        esac ;;
      i)
        if [[ ${ED:i:2} == "''" ]]; then
          case ${ED:i+2:1} in
            "'" | '$') i=$((i + 3)); continue ;;
            \\) i=$((i + 4)); continue ;;
          esac
          unset "stack[${#stack[@]}-1]"
          i=$((i + 2))
          continue
        fi
        if [[ ${ED:i:2} == '${' ]]; then stack+=(a); i=$((i + 2)); continue; fi ;;
      *)
        case $c in
          '"') stack+=(s) ;;
          "'") if [[ ${ED:i+1:1} == "'" ]]; then stack+=(i); i=$((i + 2)); continue; fi ;;
          '#') ed_skip "$i"; i=$AT; continue ;;
          /) if [[ ${ED:i+1:1} == '*' ]]; then ed_skip "$i" || return 1; i=$AT; continue; fi ;;
          '{' | '[' | '(') stack+=("$c") ;;
          '}') case $top in a | '{') unset "stack[${#stack[@]}-1]" ;; *) return 1 ;; esac ;;
          ']') [[ $top == '[' ]] || return 1; unset "stack[${#stack[@]}-1]" ;;
          ')') [[ $top == '(' ]] || return 1; unset "stack[${#stack[@]}-1]" ;;
          *) if [[ $c == "$2" && -z $top ]]; then AT=$i; return 0; fi ;;
        esac ;;
    esac
    i=$((i + 1))
  done
}
# ed_value <byte>: the value of a binding, from just past its "=": V0 and V1 (its first byte, and the one past its last
# before the ";"), and B0, where it starts past `with x;` (a list written `with pkgs; [ … ]`). Status 2: written with
# let … in or assert, which nixup does not change.
ed_value() {
  local i
  ed_skip "$1" || return 1
  i=$AT V0=$AT
  while [[ ${ED:i:5} =~ ^with[[:space:]] ]]; do
    ed_scan $((i + 5)) ';' || return 1
    ed_skip $((AT + 1)) || return 1
    i=$AT
  done
  B0=$i
  if [[ ${ED:i:7} =~ ^(let|assert)[[:space:]] ]]; then return 2; fi
  ed_scan "$i" ';' || return 1
  V1=$AT
  while [[ ${ED:V1-1:1} == [[:space:]] ]]; do V1=$((V1 - 1)); done
}
# The byte of the "}" that closes the file's set (its last, with only blank lines and comments after it), in TOP_END.
ed_top_end() {
  local t=$ED last
  while :; do
    while [[ $t == *[[:space:]] ]]; do t=${t%?}; done
    last=${t##*$'\n'}
    [[ $last =~ ^[[:space:]]*# && $t == *$'\n'* ]] || break
    t=${t%$'\n'*}
  done
  [[ $t == *'}' ]] || return 1
  TOP_END=$((${#t} - 1))
}
# A binding nixup adds, as lines: `<indent><path> = <value>;` with its comment (on its line, from column 51 as the
# template has them; above it when the value takes several lines).
binding_lines() {
  local indent=$1 text pad
  text="${indent}$2 = ${3//$'\n'/$'\n'$indent};"
  if [[ -n $4 && $text != *$'\n'* ]]; then
    if ((${#text} < 49)); then printf -v pad '%*s' $((50 - ${#text})) ''; else pad="   "; fi
    text+="${pad}# $4"
  elif [[ -n $4 ]]; then
    text="${indent}# $4"$'\n'"$text"
  fi
  printf '%s\n' "$text"
}

# edit_file <file> <out>: the plan made into <out>, from <file> and its places (with LC_ALL=C, in a subshell). An
# answer whose option the file writes in a way nixup does not change is dropped, with why, into $WORK/dropped.
edit_file() {
  local file=$1 out=$2 k n d line col at status text close lastline indent body item rel o what re
  local -a order=() r_at=() r_end=() r_text=()
  local -A ins=() first_of=() list_items=() later=()
  IFS= read -r -d '' ED < "$file" || true
  # The items of one list go in together: the list's first plan item takes them all (list_items), the others are later.
  for k in "${!PLAN_OP[@]}"; do
    [[ ${PLAN_OP[k]} == add ]] || continue
    o=${first_of[${PLAN_PATH[k]}]:-}
    if [[ -z $o ]]; then
      first_of[${PLAN_PATH[k]}]=$k list_items[$k]=${PLAN_VALUE[k]}
    else
      later[$k]=$o
      [[ $'\n'"${list_items[$o]}"$'\n' == *$'\n'"${PLAN_VALUE[k]}"$'\n'* ]] || list_items[$o]+=$'\n'"${PLAN_VALUE[k]}"
    fi
  done
  mapfile -t LINE_AT < <(awk '{ print o; o += length($0) + 1 }' "$file")
  TOP_END=-1
  ed_top_end || true
  local header=0
  [[ $ED != *"$top_header"* ]] || header=1

  for k in "${!PLAN_OP[@]}"; do
    [[ -z ${later[$k]:-} ]] || continue
    read -ra PATHN <<< "${PLAN_PATH[k]}"
    [[ $FORM != full ]] || PATHN=(config "${PATHN[@]}")
    n=${#PATHN[@]}
    if [[ -n ${PLACE["$k $n"]:-} ]]; then
      # Written: its value changes where it is.
      read -r line col <<< "${PLACE["$k $n"]}"
      at=$((LINE_AT[line - 1] + col - 1))
      status=0
      ed_names "$at" && names_end "$n" && ed_value "$AT" || status=1
      if ((status)); then
        drop "$k" "written at line $line in a way nixup does not change: change it there by hand"
        continue
      fi
      if [[ ${PLAN_OP[k]} == set ]]; then
        indent=${ED:0:V0}
        indent=${indent##*$'\n'}
        indent=${indent%%[![:space:]]*}
        replace_at "$V0" "$V1" "${PLAN_VALUE[k]//$'\n'/$'\n'$indent}"
        continue
      fi
      # add: into its list, each item unless it is there already.
      if [[ ${ED:B0:1} != '[' || ${ED:V1-1:1} != ']' ]]; then
        drop "$k" "not written as a list at line $line: add it there by hand"
        continue
      fi
      body=${ED:B0:V1-B0}
      close=$((V1 - 1))
      lastline=${ED:0:close}
      lastline=${lastline##*$'\n'}
      text=""
      while IFS= read -r item; do
        if [[ $item == \"* ]]; then
          [[ $body != *"$item"* ]] || continue
        else
          re="(^|[^A-Za-z0-9_.'-])${item//./\\.}([^A-Za-z0-9_.'-]|\$)"
          [[ ! $body =~ $re ]] || continue
        fi
        if [[ $body == *$'\n'* && $lastline =~ ^[[:space:]]*$ ]]; then
          # A list of a line an item: one more line, before its "]".
          ins[$((close - ${#lastline}))]+="${lastline}  ${item}"$'\n'
        else
          text+=" $item"
        fi
      done <<< "${list_items[$k]}"
      # A list on one line: written again with the items in it.
      if [[ -n $text ]]; then
        body=${ED:V0:close-V0}
        while [[ $body == *[[:space:]] ]]; do body=${body%?}; done
        replace_at "$V0" "$V1" "${body}${text} ]"
      fi
      continue
    fi
    # Not written: in its set when the file writes that as one ({ … }); else after another name of its set written as
    # a path (system.autoUpgrade.enable = …; for system.autoUpgrade.dates); else in the deepest set of its path written
    # as one; else at the end of the file's set.
    text=${PLAN_VALUE[k]}
    [[ ${PLAN_OP[k]} == set ]] || text="$(list_text "${PLAN_NEW[k]}" "${list_items[$k]}")"
    if [[ -n ${SIBLING[$k]:-} ]] && ! set_written "$k" $((n - 1)); then
      read -r line col <<< "${SIBLING[$k]}"
      at=$((LINE_AT[line - 1] + col - 1))
      if ed_names "$at" && ((${#NAMES[@]} >= 2)) && names_before "$n" && ed_value "$AT" && ed_scan "$V1" ';'; then
        # (after the ";" and the rest of its line: its comment)
        o=${ED:AT}
        o=${o%%$'\n'*}
        o=$((AT + ${#o} + 1))
        indent=${ED:0:at}
        indent=${indent##*$'\n'}
        rel="$(nix_attrpath "${NAMES[@]:0:${#NAMES[@]}-1}" "${PATHN[n - 1]}")"
        ins[$o]+="$(binding_lines "$indent" "$rel" "$text" "${PLAN_NOTE[k]}")"$'\n'
        continue
      fi
    fi
    close=-1
    for ((d = n - 1; d >= 1; d--)); do
      [[ -n ${PLACE["$k $d"]:-} ]] || continue
      read -r line col <<< "${PLACE["$k $d"]}"
      at=$((LINE_AT[line - 1] + col - 1))
      ed_names "$at" && names_end "$d" && ed_value "$AT" || continue
      if [[ ${ED:B0:1} == '{' && ${ED:V1-1:1} == '}' && $B0 == "$V0" ]]; then close=$((V1 - 1)); break; fi
    done
    if ((close < 0)); then
      if ((TOP_END < 0)); then
        drop "$k" "the end of the file's set was not found: add it by hand"
        continue
      fi
      close=$TOP_END d=0
    fi
    rel="$(nix_attrpath "${PATHN[@]:d}")"
    lastline=${ED:0:close}
    lastline=${lastline##*$'\n'}
    if [[ $lastline =~ ^[[:space:]]*$ ]]; then
      # The "}" starts its line: the binding goes on a line of its own, one step further in.
      indent="${lastline}  "
      if ((d == 0 && header == 0)); then
        header=1
        printf -v o '%*s' $((98 - ${#indent} - ${#top_header})) ''
        ins[$((close - ${#lastline}))]+=$'\n'"${indent}${top_header}${o// /=}"$'\n'
      fi
      ins[$((close - ${#lastline}))]+="$(binding_lines "$indent" "$rel" "$text" "${PLAN_NOTE[k]}")"$'\n'
    else
      # On one line ({ a = 1; }): on it too, without its comment (which would hide the "}").
      if [[ ${ED:close-1:1} == ' ' ]]; then ins[$close]+="$rel = $text; "; else ins[$close]+=" $rel = $text; "; fi
    fi
  done

  # From the end of the file back, so that each place found still holds; a change before an addition at one place.
  mapfile -t order < <({
    for o in "${!ins[@]}"; do printf '%s 1 i\n' "$o"; done
    for k in "${!r_at[@]}"; do printf '%s 0 %s\n' "${r_at[k]}" "$k"; done
  } | sort -s -k1,1nr -k2,2n)
  for o in "${order[@]}"; do
    read -r at _ what <<< "$o"
    if [[ $what == i ]]; then ED="${ED:0:at}${ins[$at]}${ED:at}"; else ED="${ED:0:at}${r_text[what]}${ED:r_end[what]}"; fi
  done
  printf '%s' "$ED" > "$out"
}
# drop <k> <why>: plan item k (and the later items of its list) cannot be made, for edit_file's caller to say.
drop() {
  local j
  printf '%s\t%s\n' "$1" "$2" >> "$WORK/dropped"
  for j in "${!later[@]}"; do [[ ${later[$j]} != "$1" ]] || printf '%s\t%s\n' "$j" "$2" >> "$WORK/dropped"; done
}
# A new list of the items (one a line in $2), after $1 ("with pkgs; "): on one line when it is short, else one a line.
list_text() {
  local joined=${2//$'\n'/ } line out=""
  if ((${#joined} <= 60)); then printf '%s[ %s ]' "$1" "$joined"; return 0; fi
  while IFS= read -r line; do out+=$'\n'"  $line"; done <<< "$2"
  printf '%s[%s\n]' "$1" "$out"
}
# replace_at <from> <to> <text>: the text from..to (a value) becomes <text>, and a comment after its ";" on that line
# stays in its column (as far as there is room: 3 spaces at least, or as few as it had).
re_semi='^([[:space:]]*;)( +)#'
replace_at() {
  local from=$1 to=$2 text=$3 spaces keep least pad
  if [[ $text != *$'\n'* && ${ED:from:to-from} != *$'\n'* && ${ED:to:300} =~ $re_semi ]]; then
    spaces=${#BASH_REMATCH[2]}
    least=3
    ((spaces >= 3)) || least=$spaces
    keep=$((spaces - ${#text} + to - from))
    ((keep >= least)) || keep=$least
    printf -v pad '%*s' "$keep" ''
    r_at+=("$from") r_end+=($((to + ${#BASH_REMATCH[1]} + spaces))) r_text+=("${text}${BASH_REMATCH[1]}${pad}")
  else
    r_at+=("$from") r_end+=("$to") r_text+=("$text")
  fi
}
# set_written <k> <depth>: plan item k's path's first <depth> names are a set written as one ({ … }).
set_written() {
  local line col at
  [[ -n ${PLACE["$1 $2"]:-} ]] || return 1
  read -r line col <<< "${PLACE["$1 $2"]}"
  at=$((LINE_AT[line - 1] + col - 1))
  ed_names "$at" && names_end "$2" && ed_value "$AT" && [[ ${ED:B0:1} == '{' && ${ED:V1-1:1} == '}' && $B0 == "$V0" ]]
}
# names_before <n>: the binding's names (NAMES), but its last, are the last names of the path's set (its first n - 1),
# as a sibling written as a path has them.
names_before() {
  local m=$((${#NAMES[@]} - 1)) j
  (($1 - 1 >= m)) || return 1
  for ((j = 0; j < m; j++)); do [[ ${NAMES[j]} == "${PATHN[$1 - 1 - m + j]}" ]] || return 1; done
}
# names_end <depth>: the binding's attribute path (NAMES) is how the file writes the path's first <depth> names, from
# the set it is in: its last names (a binding written a.b.c = … is not the set a.b).
names_end() {
  local m=${#NAMES[@]} j
  ((m <= $1)) || return 1
  for ((j = 0; j < m; j++)); do [[ ${NAMES[j]} == "${PATHN[$1 - m + j]}" ]] || return 1; done
}

# apply_plan <file> <out>: the plan made into <out>, and checked; <file> stays as it is. DROPPED: what could not be
# changed, with why (by plan item).
declare -A DROPPED=()
apply_plan() {
  local file=$1 out=$2 k why
  local -a paths=()
  DROPPED=()
  for k in "${!PLAN_OP[@]}"; do paths+=("${PLAN_PATH[k]}"); done
  places "$file" "${paths[@]}" || return 1
  if [[ $SHAPE == other ]]; then
    bad "$(pretty "$file") is not written as a set of options (lib.mkMerge or lib.mkIf around it, say): nixup cannot change it."
    return 1
  fi
  : > "$WORK/dropped"
  # shellcheck disable=SC2030 # (bytes, in the subshell only)
  (export LC_ALL=C; edit_file "$file" "$out") || { bad "nixup could not change the file."; return 1; }
  while IFS=$'\t' read -r k why; do DROPPED[$k]=$why; done < "$WORK/dropped"
}

# show_diff <before> <after>: what changed, lines taken out in red and added in green.
show_diff() {
  local line
  diff -U 2 "$1" "$2" | tail -n +3 | while IFS= read -r line; do
    case $line in
      @@*) say "    ${c_acc}${c_d}${line}${c_r}" ;;
      +*) say "    ${c_ok}${line}${c_r}" ;;
      -*) say "    ${c_err}${line}${c_r}" ;;
      *) say "    ${c_d}${line}${c_r}" ;;
    esac
  done || true
}

# --- The questions, about what a phone cannot tell; each one says what its option does, and what the config has now.

# The options the questions show, by path: their index in what places found.
QPATHS=(
  "android updates onlyOnUnmetered" "system autoUpgrade enable" "system autoUpgrade dates" "android strict enable"
  "android adb port" "android adb trustedKeys" "services openssh enable" "services openssh listenAddresses"
  "users users root openssh authorizedKeys keys" "services tailscale enable" "services tailscale authKeyFile"
  "services ntfy enable" "services ntfy topics" "services caldav enable" "services syncthing enable"
  "android backup repository" "environment systemPackages" "nix gc automatic" "android playstore account"
  "android playstore tokenFile" "nix distributedBuilds" "nix settings substituters" "nixpkgs config allowUnfree"
  "android autoUpgrade onlyOnUnmetered" "android autoUpgrade onlyWhileCharging" "android strict keep"
  "services ntfy unifiedPush enable" "services caldav accounts main" "android backup passwordFile"
  "android backup apps" "android backup defaults autoRestore"
)
# look_options <file>: the questions' options in the file (places: the paths above, and each source's updates), and
# as the config gives them (look_effective).
look_options() {
  local i s
  local -a all=()
  places "$1" || return 1
  [[ $SHAPE != other ]] || die "$(pretty "$1") is not written as a set of options (lib.mkMerge or lib.mkIf around it, say): nixup cannot change it."
  all=("${QPATHS[@]}")
  for s in "${SOURCES[@]}"; do all+=("android settings repo $s autoupdatePackages"); done
  [[ " ${SOURCES[*]} " == *" playstore "* ]] || all+=("android settings repo playstore autoupdatePackages")
  places "$1" "${all[@]}" || return 1
  QIDX=()
  for i in "${!all[@]}"; do QIDX[${all[i]}]=$i; done
  literals "$1" "${all[@]}"
  look_effective "$1" "${all[@]}"
}
# literals <file> <path>...: whether the file writes each path's value as itself (true, 5555, "text", ./file, a list
# or set as written), in LITERAL by index: no for one it works out (hostConfig.adb.port, lib.mkDefault true, "${x}"),
# which Nix's look at it cannot tell apart once it is evaluated: the file's text tells.
declare -A LITERAL=()
literals() {
  local i v out
  LITERAL=()
  # shellcheck disable=SC2030,SC2031 # (bytes, in the subshell only)
  out="$(export LC_ALL=C; literal_lines "$@")"
  while read -r i v; do [[ -z $i ]] || LITERAL[$i]=$v; done <<< "$out"
}
literal_lines() {
  local file=$1 p i=0 n line col at
  local -a names
  shift
  IFS= read -r -d '' ED < "$file" || true
  mapfile -t LINE_AT < <(awk '{ print o; o += length($0) + 1 }' "$file")
  for p in "$@"; do
    read -ra names <<< "$p"
    n=${#names[@]}
    [[ $FORM != full ]] || n=$((n + 1))
    if [[ -n ${PLACE["$i $n"]:-} ]]; then
      read -r line col <<< "${PLACE["$i $n"]}"
      at=$((LINE_AT[line - 1] + col - 1))
      if ed_names "$at" && ed_value "$AT" && is_literal "${ED:V0:V1-V0}"; then echo "$i yes"; else echo "$i no"; fi
    fi
    i=$((i + 1))
  done
}
re_literal='^(true|false|null|-?[0-9]+(\.[0-9]+)?|"([^"\\$]|\\.|\$[^{])*"|\.{1,2}/[A-Za-z0-9._+/-]+)$'
is_literal() {
  [[ $1 =~ $re_literal ]] && return 0
  [[ $1 == \[*\] || $1 == \{*\} ]] && return 0
  [[ $1 =~ ^with[[:space:]]+[A-Za-z_.]+[[:space:]]*\;[[:space:]]*\[.*\]$ ]] && return 0
  return 1
}

# look_effective <file> <path>...: each path as the config gives it, through its modules: its flake's configuration
# (CFG_NAME: the flake as it is, with the file's other modules, inputs and arguments), or the file alone with its
# imports. LOOKED is 1 when the config could be evaluated so; then, by path: HAS (yes, or no: not in the Nixup it is
# built with), EKIND and ETEXT (its value, as VKIND and VTEXT), EFROM (the files that set it, split by the unit
# separator) and EPRIO (their priority). SELF: the file, as EFROM names it.
LOOKED=0 SELF=""
HAS=() EKIND=() ETEXT=() EFROM=() EPRIO=()
look_effective() {
  local file=$1 p name json="[" out kind a b c
  shift
  LOOKED=0 HAS=() EKIND=() ETEXT=() EFROM=() EPRIO=()
  command -v nix > /dev/null || return 0
  for p in "$@"; do
    json+="["
    for name in $p; do json+="$(nix_str "$name"),"; done
    json="${json%,}],"
  done
  printf '%s' "${json%,}]" > "$WORK/look.json"
  say "  ${c_d}Reading what the config gives them, through its modules…${c_r}"
  if [[ -n $CFG_NAME ]]; then
    SELF=$CFG_REL
    out="$(NIXUP_HELPER="$here/nixup.nix" NIXUP_REF="$CFG_REF" NIXUP_NAME="$CFG_NAME" NIXUP_PATHS="$WORK/look.json" nixx eval --raw --impure --expr \
      'import (builtins.getEnv "NIXUP_HELPER") { look = true; flakeRef = builtins.getEnv "NIXUP_REF"; configName = builtins.getEnv "NIXUP_NAME"; pathsFile = builtins.getEnv "NIXUP_PATHS"; }' \
      2> "$WORK/look.err" || true)"
  else
    SELF=$file
    local -a lookup=(nixx eval "${NIXPKGS[@]}")
    if nixpkgs_path; then lookup=(nix_lookup -I nixpkgs="$NIXPKGS_PATH"); fi
    out="$(NIXUP_HELPER="$here/nixup.nix" NIXUP_FILE="$file" NIXUP_DIR="$nixup_dir" NIXUP_PATHS="$WORK/look.json" "${lookup[@]}" --raw --impure --expr \
      'import (builtins.getEnv "NIXUP_HELPER") { look = true; file = builtins.getEnv "NIXUP_FILE"; nixupDir = builtins.getEnv "NIXUP_DIR"; pathsFile = builtins.getEnv "NIXUP_PATHS"; }' \
      2> "$WORK/look.err" || true)"
  fi
  while IFS=$'\t' read -r kind a b c; do
    case $kind in
      looked) LOOKED=1 ;;
      nixup) CFG_NIXUP=$a ;;
      has) HAS[a]=$b ;;
      eff) EKIND[a]=$b ETEXT[a]=${c:-} ;;
      from) EFROM[a]+="${b}"$'\037' ;;
      prio) EPRIO[a]=$b ;;
    esac
  done <<< "$out"
  if ((LOOKED == 0)); then
    note "(The config could not be evaluated here$(err_line "$WORK/look.err"): what it has now is read from the file alone, and what other files set is not seen.)" 4
  fi
}

# where_set <path>: where the config sets path: " (line N)" here, " (set in <files>)", " (Nixup's default)".
where_set() {
  local i=${QIDX[$1]} f others="" n=0 mine=0 nixup_only=1
  if ((LOOKED == 0)); then at_line "$1"; return 0; fi
  if [[ -z ${EFROM[i]:-} ]]; then printf " (Nixup's default)"; return 0; fi
  while IFS= read -r f; do
    [[ -n $f ]] || continue
    if [[ $f == "$SELF" ]]; then mine=1; continue; fi
    [[ $f == nixup:* ]] || nixup_only=0
    n=$((n + 1))
    ((n > 2)) || others+=", $(file_name "$f")"
  done < <(printf '%s' "${EFROM[i]}" | tr '\037' '\n')
  others=${others#, }
  ((n <= 2)) || others+=" and $((n - 2)) more"
  if [[ -z $others && ${LITERAL[$i]:-yes} == no ]]; then printf ' (worked out at line %s)' "$(at_line "$1" | tr -dc '0-9')"
  elif [[ -z $others ]]; then at_line "$1"
  elif ((${EPRIO[i]:-100} > 100)) && ((nixup_only)); then printf " (Nixup's default)"
  elif ((${EPRIO[i]:-100} > 100)); then printf ' (a default, from %s)' "$others"
  elif ((mine)); then printf ' (set here%s and in %s)' "$(at_line "$1" | sed 's/^ (/, /; s/)$//')" "$others"
  else printf ' (set in %s)' "$others"
  fi
}
# A file as EFROM names it, in words: Nixup's own, a flake's input's, the flake's, or a whole path.
file_name() {
  case $1 in
    nixup:*) printf "Nixup's %s" "${1#nixup:}" ;;
    /*) pretty "$1" ;;
    *) printf '%s' "$1" ;;
  esac
}
# other_files <path>: the files that set path besides this one, in words (none: nothing).
other_files() {
  local i=${QIDX[$1]} f out=""
  ((LOOKED)) || return 0
  while IFS= read -r f; do
    [[ -n $f && $f != "$SELF" ]] || continue
    out+=", $(file_name "$f")"
  done < <(printf '%s' "${EFROM[i]:-}" | tr '\037' '\n')
  printf '%s' "${out#, }"
}
# value_of <path>: the kind and text of path's value (KIND, TEXT): the config's when it was evaluated, else the file's.
value_of() {
  local i=${QIDX[$1]}
  if ((LOOKED)) && [[ ${HAS[i]:-} == yes ]]; then KIND=${EKIND[i]:-unset} TEXT=${ETEXT[i]:-}
  else KIND=${VKIND[i]} TEXT=${VTEXT[i]}; fi
}
# What the config gives path, in words: now_bool <path> <words for true> <words for false> <Nixup's default: true|false>.
now_bool() {
  local words
  if ! has_option "$1"; then printf "not in the Nixup this config is built with%s" "${CFG_NIXUP:+ ($CFG_NIXUP)}"; return 0; fi
  value_of "$1"
  case $KIND in
    bool) if [[ $TEXT == true ]]; then words=$2; else words=$3; fi; printf '%s%s' "$words" "$(where_set "$1")" ;;
    unset) if [[ $4 == true ]]; then words=$2; else words=$3; fi; printf "%s (Nixup's default)" "$words" ;;
    *) printf 'written as an expression%s' "$(where_set "$1")" ;;
  esac
}
now_value() {
  if ! has_option "$1"; then printf "not in the Nixup this config is built with%s" "${CFG_NIXUP:+ ($CFG_NIXUP)}"; return 0; fi
  value_of "$1"
  case $KIND in
    unset) printf '%s' "$2" ;;
    null) printf 'none%s' "$(where_set "$1")" ;;
    bool | int | string | path) printf '%s%s' "$TEXT" "$(where_set "$1")" ;;
    list) printf '%s item(s)%s' "$(list_count "$TEXT")" "$(where_set "$1")" ;;
    items) printf '%s item(s)%s' "$TEXT" "$(where_set "$1")" ;;
    *) printf 'written as an expression%s' "$(where_set "$1")" ;;
  esac
}
# at_line <path>: " (line N)", when the file writes path.
at_line() {
  local -a p
  read -ra p <<< "$1"
  local depth=${#p[@]}
  [[ $FORM != full ]] || depth=$((depth + 1))
  local place=${PLACE["${QIDX[$1]} $depth"]:-}
  [[ -z $place ]] || printf ' (line %s)' "${place%% *}"
}
list_count() { if [[ -z $1 ]]; then echo 0; else printf '%s' "$1" | tr '\037' '\n' | wc -l | tr -d ' '; fi; }
# has_option <path>: the Nixup the config is built with has the option (as far as is known).
has_option() {
  local i=${QIDX[$1]:-}
  [[ -n $i ]] || return 0
  ((LOOKED == 0)) || [[ ${HAS[i]:-yes} == yes ]]
}
# editable <path> <set|add>: nixup may change path in this file, or says why not (under the question): the Nixup the
# config is built with has not got the option; the file writes it as an expression (a variable, lib.mkForce …); or
# another file sets it, which a value here would conflict with (set), or whose default list a list here would replace
# (add). A list another file sets as a plain one takes items from here too: they are joined.
editable() {
  local i=${QIDX[$1]} others
  if ! has_option "$1"; then
    note "Not in the Nixup this config is built with${CFG_NIXUP:+ ($CFG_NIXUP, as its flake.lock pins it)}: update that first (nix flake update nixup, in its flake) to have it."
    return 1
  fi
  if [[ ${VKIND[i]} == other || ${LITERAL[$i]:-yes} == no ]]; then
    note "The file works it out$(at_line "$1" | sed 's/ (line \(.*\))/ at line \1/'), from a variable, a function or another option: nixup leaves it as it is (change it there by hand)."
    return 1
  fi
  others="$(other_files "$1")"
  if [[ -n $others && $2 == set ]] && ((${EPRIO[i]:-100} <= 100)); then
    note "It is set in $others: change it there (a value here would conflict with it)."
    return 1
  fi
  if [[ -n $others && $2 == add ]] && ((${EPRIO[i]:-100} > 100)); then
    note "Its list is a default from $others, which a list here would replace: add to it there."
    return 1
  fi
  return 0
}
# list_has <path> <item>: the config's list (else the file's) has an item whose first two words are the item's (a key,
# whatever its comment).
list_has() {
  local item
  local -a want got
  read -ra want <<< "$2"
  value_of "$1"
  [[ $KIND == list && -n $TEXT ]] || return 1
  while IFS= read -r item; do
    read -ra got <<< "$item"
    [[ ${got[0]:-} != "${want[0]}" || ${got[1]:-} != "${want[1]:-}" ]] || return 0
  done < <(printf '%s\n' "$TEXT" | tr '\037' '\n')
  return 1
}
source_name() {
  case $1 in
    fdroid) echo F-Droid ;; izzyondroid) echo IzzyOnDroid ;; guardianproject) echo "Guardian Project" ;;
    playstore) echo "Google Play" ;; obtainium) echo "developers' releases" ;; *) echo "$1" ;;
  esac
}

# --- Nix packages, looked up as the phone gets them: nixpkgs' build for 64-bit ARM (aarch64-linux), from cache.nixos.org
# (or the config's other caches, nix.settings.substituters), since it builds no package itself; only build machines do
# (nix.buildMachines, with nix.distributedBuilds).

# This computer's nixpkgs as a folder (fetched first, when NIX_PATH names a flake), in NIXPKGS_PATH.
NIXPKGS_PATH=""
nixpkgs_path() {
  [[ -z $NIXPKGS_PATH ]] || return 0
  find_nixpkgs
  NIXPKGS_PATH="$(nix-instantiate "${NIXPKGS[@]}" --find-file nixpkgs 2> /dev/null || true)"
  [[ -n $NIXPKGS_PATH ]]
}
# nix eval, which reads nixpkgs but writes nothing to the store and needs no daemon (a store of its own, dummy://),
# where this nix can.
nix_lookup() {
  if nix --extra-experimental-features nix-command eval --help 2> /dev/null | grep -q -- '--read-only'; then
    nixx --store dummy:// eval --read-only "$@"
  else
    nixx eval "$@"
  fi
}

# Each package looked up once (PKG_SAID: "ok", "warn:<why it goes all the same>", or why it cannot go on the phone).
declare -A PKG_SAID=()
# check_packages <name>...: each one in nixpkgs for 64-bit ARM, and in the caches, with a line for each: ✔, or ✘ and
# why. PKGS_OK: those that can go on the phone. Status 1: one cannot; 2: they could not be looked up (Nix says why).
check_packages() {
  local name what kind rest out version="" builders=0 unfree_ok=0 failed=0 offline=0 i
  local -a todo=() caches=(https://cache.nixos.org)
  local -A seen=()
  PKGS_OK=()
  for name; do
    [[ -z ${seen[$name]:-} ]] || continue
    seen[$name]=1
    [[ -z ${PKG_SAID[$name]:-} ]] || continue
    if [[ $name =~ ^[A-Za-z0-9_][A-Za-z0-9_\'+-]*(\.[A-Za-z0-9_][A-Za-z0-9_\'+-]*)*$ ]]; then todo+=("$name")
    else PKG_SAID[$name]="that is not a package's name: letters, digits, - and _ (and a dot between a set and a package in it)"; fi
  done
  # The config's own ways: other caches, build machines, unfree packages allowed.
  i=${QIDX["nix settings substituters"]:-}
  if [[ -n $i && ${VKIND[i]} == list && -n ${VTEXT[i]} ]]; then
    mapfile -t -O 1 caches < <(printf '%s\n' "${VTEXT[i]}" | tr '\037' '\n' | sed 's|/*$||')
  fi
  i=${QIDX["nix distributedBuilds"]:-}
  [[ -z $i || ${VTEXT[i]} != true ]] || builders=1
  i=${QIDX["nixpkgs config allowUnfree"]:-}
  [[ -z $i || ${VTEXT[i]} != true ]] || unfree_ok=1
  if ((${#todo[@]})); then
    say "    ${c_d}Looking them up in nixpkgs, built for 64-bit ARM (the phone's), and in cache.nixos.org…${c_r}"
    nixpkgs_path || { bad "There is no nixpkgs here to look them up in (NIX_PATH, or the flake registry's nixpkgs)."; return 2; }
    out="["
    for name in "${todo[@]}"; do out+="$(nix_str "$name"),"; done
    printf '%s' "${out%,}]" > "$WORK/packages.json"
    out="$(NIXUP_HELPER="$here/nixup.nix" NIXUP_PACKAGES="$WORK/packages.json" NIXUP_NIXPKGS="$NIXPKGS_PATH" \
      nix_lookup --raw --impure -I nixpkgs="$NIXPKGS_PATH" --expr \
      'import (builtins.getEnv "NIXUP_HELPER") { packagesFile = builtins.getEnv "NIXUP_PACKAGES"; nixpkgsPath = builtins.getEnv "NIXUP_NIXPKGS"; }' \
      2> "$WORK/packages.err")" || {
      bad "Nix could not look them up:"
      sed -n '/error:/,$p' "$WORK/packages.err" | grep -v '^ *… while' | head -n 8 | indent
      return 2
    }
    while IFS=$'\t' read -r what name kind rest; do
      case $what in
        nixpkgs) version=$name ;;
        package) package_said "$name" "$kind" "${rest:-}"; PKG_SAID[$name]=$SAID ;;
      esac
    done <<< "$out"
  fi
  for name; do
    [[ -n ${seen[$name]:-} ]] || continue
    unset 'seen[$name]'
    case ${PKG_SAID[$name]} in
      ok)
        say "    ${c_ok}${s_ok}${c_r} ${c_b}${name}${c_r}  ${c_d}built for 64-bit ARM, in cache.nixos.org${c_r}"
        PKGS_OK+=("$name") ;;
      warn:*)
        say "    ${c_warn}${s_warn}${c_r} ${c_b}${name}${c_r}"
        note "${PKG_SAID[$name]#warn:}" 6
        PKGS_OK+=("$name") ;;
      *)
        say "    ${c_err}${s_no} ${c_b}${name}${c_r}"
        note "${PKG_SAID[$name]}" 6
        failed=1 ;;
    esac
  done
  return "$failed"
}
# package_said <name> <kind> <rest>: what nixup.nix found of a package, said in SAID: "ok", "warn:<why>" (it goes all
# the same), or why it cannot go on the phone. (check_packages' version, caches, builders, unfree_ok and offline: run in
# check_packages' shell, not a subshell, so that a cache that did not answer is not asked again.)
package_said() {
  local name=$1 rest=$3 hash url code found="" at
  at="this computer's nixpkgs${version:+, $version}"
  case $2 in
    ok)
      hash=${rest#/nix/store/}
      hash=${hash%%-*}
      # (One cache that did not answer, and the others are not asked again: each would wait as long.)
      ((offline == 0)) || found=unknown
      for url in "${caches[@]}"; do
        [[ -z $found ]] || break
        code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 8 "$url/$hash.narinfo" 2> /dev/null || true)"
        case $code in
          200) found=yes ;;
          404 | 403 | 410) ;;
          *) found=unknown offline=1 ;;
        esac
      done
      if [[ $found == yes ]]; then SAID=ok
      elif [[ $found == unknown ]]; then SAID="warn:built for 64-bit ARM; whether cache.nixos.org has it was not found out (it did not answer): a dry run tells"
      elif ((builders)); then SAID="warn:no cache has it for 64-bit ARM (at $at): your build machines build it (nix.buildMachines)"
      else SAID="no cache has it built for 64-bit ARM (at $at), and the phone builds no package itself: nix.buildMachines can (with nix.distributedBuilds)"
      fi ;;
    missing)
      if [[ -n $rest ]]; then
        rest=${rest// /, }
        [[ $rest != *,* ]] || rest="${rest%, *} or ${rest##*, }"
        SAID="nixpkgs has no package called $name: did you mean $rest?"
      else
        SAID="nixpkgs has no package called $name (search.nixos.org finds them by name and description)"
      fi ;;
    notPackage)
      case $rest in
        set) SAID="$name is a set of packages in nixpkgs, not one: name one in it, like $name.<package> (search.nixos.org lists them)" ;;
        lambda) SAID="$name is a function in nixpkgs, not a package" ;;
        *) SAID="$name is not a package in nixpkgs (it is a ${rest:-value})" ;;
      esac ;;
    platform)
      rest=${rest// /, }
      [[ $rest != *,* ]] || rest="${rest%, *} and ${rest##*, }"
      SAID="not for 64-bit ARM phones: nixpkgs has it for ${rest:-other systems} only" ;;
    broken) SAID="marked broken in nixpkgs for 64-bit ARM: it does not build there" ;;
    unfree)
      if ((builders && unfree_ok)); then SAID="warn:unfree, so no cache has it: your build machines build it (nix.buildMachines)"
      elif ((builders)); then SAID="unfree: cache.nixos.org has no unfree package, and building it on your build machines needs nixpkgs.config.allowUnfree = true"
      else SAID="unfree: cache.nixos.org has no unfree package, and the phone builds no package itself (build machines can: nix.buildMachines, with nix.distributedBuilds and nixpkgs.config.allowUnfree)"
      fi ;;
    insecure) SAID="nixpkgs marks it insecure: $rest" ;;
    hydra)
      if ((builders)); then SAID="warn:nixpkgs' cache does not build it for 64-bit ARM: your build machines build it (nix.buildMachines)"
      else SAID="nixpkgs' cache does not build it for 64-bit ARM (meta.hydraPlatforms), and the phone builds no package itself"
      fi ;;
    *)
      rest="$(package_error "$name")"
      SAID="nixpkgs stops on it for 64-bit ARM${rest:+: $rest}" ;;
  esac
}
# What Nix says when it evaluates package $1 for aarch64-linux (removed, renamed, only for x86, ...): its last error line.
package_error() {
  local -a parts
  IFS=. read -ra parts <<< "$1"
  NIXUP_NIXPKGS="$NIXPKGS_PATH" nix_lookup --raw --impure --expr \
    "(import (builtins.getEnv \"NIXUP_NIXPKGS\") { system = \"aarch64-linux\"; config = { }; overlays = [ ]; }).$(nix_attrpath "${parts[@]}").outPath" \
    2>&1 > /dev/null | sed -n 's/^ *error: //p' | tail -n 1 || true
}
# A package's name as an item of `with pkgs; [ … ]`: as it is, or pkgs."<name>" when it is no plain name (7zz).
pkg_item() {
  local text
  local -a parts
  IFS=. read -ra parts <<< "$1"
  text="$(nix_attrpath "${parts[@]}")"
  if [[ $text == "$1" ]]; then printf '%s' "$1"; else printf 'pkgs.%s' "$text"; fi
}

# --- Google Play's token, signed in for here (nixup-play-login).
# play_sign_in <file>: signs in (a window with Google's page, or the browser), the token into <file> and the account's
# address in PLAY_ACCOUNT. What it says is shown up to the token itself, which stays off the screen (it is in the file).
play_sign_in() {
  local line out=$WORK/play-$BASHPID.out status=0
  PLAY_ACCOUNT=""
  rm -f "$1" "$out"
  say ""
  "$here/nixup-play-login" --out "$1" | {
    while IFS= read -r line; do
      if [[ $line == "Signed in to Google Play as "* ]]; then printf '%s\n' "$line" > "$out"; break; fi
      printf '    %s\n' "$line" >&2
    done
    cat > /dev/null
  } || status=$?
  ((status == 0)) && [[ -s $1 ]] || return 1
  PLAY_ACCOUNT="$(sed -n 's/^Signed in to Google Play as \(.*\)\. Its token.*/\1/p' "$out" 2> /dev/null | head -n 1)"
}
# What the config has for Google Play's account, in words (never the token itself).
now_token() {
  local words account
  value_of "android playstore tokenFile"
  case $KIND in
    path) words="a token from $(pretty "$TEXT")$(where_set "android playstore tokenFile")" ;;
    string)
      if [[ $TEXT == aas_et/* ]]; then words="a token, given as text$(where_set "android playstore tokenFile")"
      else words="a token from $TEXT on the phone$(where_set "android playstore tokenFile")"; fi ;;
    unset | null) words="no token: the phone signs in itself (Nixup app: ⋮ → Google Play account)" ;;
    *) words="written as an expression$(where_set "android playstore tokenFile")" ;;
  esac
  value_of "android playstore account"
  [[ $KIND != string ]] || words+="; account $TEXT"
  printf '%s' "$words"
}

# The answer to "Sign in to Google Play here?": a sign-in now (its token kept for the config), a token of this run's
# kept (after Answer again), or none; and with none, the account's address for the apps from Google Play (optional).
play_question() {
  local token=$WORK/google-play-$BASHPID.token
  if ! command -v curl > /dev/null; then
    note "(The sign-in needs curl, which is not here.)"
    KEY=s
  elif [[ -s $token ]]; then
    key yks k "${c_acc}k${c_r} keep the token you signed in for ${c_d}(Enter)${c_r}  ${c_acc}y${c_r} sign in again  ${c_acc}s${c_r} skip"
  else
    key ys s "${c_acc}y${c_r} sign in now  ${c_acc}s${c_r} skip ${c_d}(Enter)${c_r}"
  fi
  case $KEY in
    y)
      answered "sign in"
      if play_sign_in "$token"; then
        printf '%s\n' "$PLAY_ACCOUNT" > "$token.account"
        ok "Signed in to Google Play${PLAY_ACCOUNT:+ as $PLAY_ACCOUNT}: its token goes next to the config when the config is written."
      else
        rm -f "$token"
        warn "The sign-in did not finish (why is above): skipped. The menu's Google Play sign-in can do it later."
      fi ;;
    k) answered "keep it" ;;
    *) answered "${c_d}skip" ;;
  esac
  if [[ $KEY != s && -s $token ]]; then
    PLAY_ACCOUNT="$(cat "$token.account" 2> /dev/null || true)"
    plan_file_copy google-play.token "$token"
    plan_set "android playstore tokenFile" ./google-play.token "secret: the phone needs no sign-in" "Google Play's token: ./google-play.token, from your sign-in"
    if [[ -n $PLAY_ACCOUNT ]]; then
      plan_set "android playstore account" "$(nix_str "$PLAY_ACCOUNT")" "builds stop if another account is signed in" "Google Play's account: $PLAY_ACCOUNT"
    fi
  elif ((PLAY_LIST)) && [[ ${VKIND[${QIDX["android playstore account"]}]} == unset ]]; then
    ask "The account's email address (optional: a build stops when another one is signed in)" "" ""
    if [[ $ANSWER == *@*.* ]]; then
      plan_set "android playstore account" "$(nix_str "$ANSWER")" "builds stop if another account is signed in" "Google Play's account: $ANSWER"
    fi
  fi
}

# The apps nixup-config found installed from Google Play, which it writes as comments under "From Google Play".
play_ids() {
  awk '/^  # From Google Play:/ { on = 1; next } on && /^  #   "/ { match($0, /"[^"]+"/); print substr($0, RSTART + 1, RLENGTH - 2); next } on && !/^  # / { on = 0 }' "$1"
}
# Those comments made android.packages.playstore, which installs them.
play_list() {
  awk '
    /^  # From Google Play:/ {
      on = 1
      print "  # From Google Play, installed and kept up to date by Nixup with the Google account signed in on the phone"
      print "  # (Nixup app: ⋮ → Google Play account), or android.playstore.tokenFile."
      print "  android.packages.playstore = ["
      next
    }
    on && /^  #   "/ { match($0, /"[^"]+"/); print "    " substr($0, RSTART, RLENGTH); next }
    on && /^  # / { next }
    on { print "  ];"; on = 0 }
    { print }
    END { if (on) print "  ];" }
  ' "$1"
}

# questions <create|edit> <file>: what the phone cannot tell, part by part, into the plan; Enter skips a question, which
# leaves its option as the file has it. MAKE_FLAKE and PLAY_LIST (create): a flake.nix too, and the apps from Google
# Play listed.
questions() {
  local mode=$1 file=$2 s n all key_file key t ids=() srcs=() play=() words passed status names=()
  plan_reset
  MAKE_FLAKE=0 PLAY_LIST=0
  look_options "$file" || return 1

  # Google Play: the apps nixup-config found from it (it leaves them as comments), and the account's token.
  [[ $mode != create ]] || mapfile -t play < <(play_ids "$file")
  page "Google Play" "Apps from Google Play are downloaded by the phone itself, as Aurora Store does (no Play Store needed), with a Google account: signed in on the phone (Nixup app: ⋮ → Google Play account), or its token, from a sign-in on this computer."
  if ((${#play[@]})); then
    question "Have Nixup install the phone's apps from Google Play, and keep them up to date?" \
      "${#play[@]} of its apps came from Google Play: ${play[*]:0:4}$( ((${#play[@]} <= 4)) || printf ', …'). Disable: they stay in the config as comments, and on the phone as they are."
    eds
    [[ $KEY != e ]] || PLAY_LIST=1
  fi
  if editable "android playstore tokenFile" set; then
    question "Sign in to Google Play here, for the account's token?" \
      "Then the phone needs no sign-in: the token is kept next to the config (./google-play.token, readable by you alone) and each build puts it on the phone. A window with Google's own sign-in page opens (or your browser, with the steps to follow). Better an account of its own: Google may block one that downloads with an unofficial client." \
      "$(now_token)"
    play_question
  fi

  page "App updates" "How the phone keeps the config's apps up to date: every 6 hours it looks for new versions."
  for s in "${SOURCES[@]}"; do
    [[ $s != nix ]] || continue
    [[ ${SRC_COUNT[$s]:-0} != 0 || ($s == playstore && $PLAY_LIST == 1) ]] || continue
    srcs+=("$s")
  done
  if ((PLAY_LIST)) && [[ " ${srcs[*]} " != *" playstore "* ]]; then srcs+=(playstore); fi
  if ((${#srcs[@]})); then
    words=""
    for s in "${srcs[@]}"; do words+=", $(source_name "$s"): $(now_bool "android settings repo $s autoupdatePackages" on off false)"; done
    question "Install app updates by themselves?" \
      "Enable: the phone installs new versions of the config's apps by itself, with a notification. Disable: it only tells you, and the app's Updates tab installs them." \
      "${words#, }"
    eds p "for each source"
    all=$KEY
    for s in "${srcs[@]}"; do
      t="android settings repo $s autoupdatePackages"
      case $all in
        e | d) editable "$t" set || continue ;;&
        e) plan_set "$t" true "$(source_name "$s")'s apps update by themselves" "$(source_name "$s"): updates installed by themselves" ;;
        d) plan_set "$t" false "$(source_name "$s")'s updates are only told about" "$(source_name "$s"): updates only told about" ;;
        p)
          editable "$t" set || continue
          n=${SRC_COUNT[$s]:-0}
          [[ $s != playstore ]] || ((PLAY_LIST == 0)) || n=${#play[@]}
          printf -v words '%-24s' "$(source_name "$s") (${n/\?/some} apps)"
          say "    ${c_b}${words}${c_r}"
          key eds s "  ${c_acc}e${c_r} enable  ${c_acc}d${c_r} disable  ${c_acc}s${c_r} skip ${c_d}(Enter)${c_r}"
          case $KEY in
            e) answered "${c_ok}enable"; plan_set "$t" true "$(source_name "$s")'s apps update by themselves" "$(source_name "$s"): updates installed by themselves" ;;
            d) answered "${c_warn}disable"; plan_set "$t" false "$(source_name "$s")'s updates are only told about" "$(source_name "$s"): updates only told about" ;;
            *) answered "${c_d}skip" ;;
          esac ;;
      esac
    done
  else
    note "(The config lists no apps yet, so there is nothing to update.)"
  fi

  question "Look for updates on mobile data too?" \
    "Off: only on Wi-Fi, and a check that falls on mobile data waits for Wi-Fi. On: on mobile data too, and right away whenever the phone comes online." \
    "$(now_bool "android updates onlyOnUnmetered" "Wi-Fi only" "mobile data too" true)"
  if editable "android updates onlyOnUnmetered" set; then
    eds
    case $KEY in
      e) plan_set "android updates onlyOnUnmetered" false "the update check runs on mobile data too" "Updates are looked for on mobile data too" ;;
      d) plan_set "android updates onlyOnUnmetered" true "the update check waits for Wi-Fi" "Updates are looked for on Wi-Fi only" ;;
    esac
  fi

  question "Build the whole config again by itself, every day?" \
    "As NixOS's system.autoUpgrade: at a time of day the phone builds its config again with everything at its newest (the app's Upgrade), and applies it." \
    "$(now_bool "system autoUpgrade enable" on off false)"
  if editable "system autoUpgrade enable" set; then
    eds
    case $KEY in
      e)
        t=04:40
        [[ ${VKIND[${QIDX["system autoUpgrade dates"]}]} != string ]] || t=${VTEXT[${QIDX["system autoUpgrade dates"]}]}
        ask "At what time (24h, or like \"daily\")" "$t"
        plan_set "system autoUpgrade enable" true "builds again by itself" "The config is built again every day at $ANSWER"
        plan_set "system autoUpgrade dates" "$(nix_str "$ANSWER")" "when (systemd's calendar times, like \"daily\")" ""
        if confirm "Only on Wi-Fi? (an upgrade can download a lot)" y; then t=true; else t=false; fi
        plan_set "android autoUpgrade onlyOnUnmetered" "$t" "false: on mobile data too" ""
        if confirm "Only while it charges?" n; then t=true; else t=false; fi
        plan_set "android autoUpgrade onlyWhileCharging" "$t" "true: only on the charger" "" ;;
      d) plan_set "system autoUpgrade enable" false "no builds by itself" "No daily builds" ;;
    esac
  fi

  question "Remove the apps the config does not list?" \
    "Strict mode: each build hides every app installed by hand that no list of the config has. It stays on the phone with its data, and comes back as it was when strict is off again. Nixup, the root app, the keyboard and the launcher in use always stay." \
    "$(now_bool "android strict enable" on off false)"
  if editable "android strict enable" set; then
    eds
    case $KEY in
      e)
        plan_set "android strict enable" true "the apps no list has are removed" "Strict: apps the config does not list are removed"
        ask "Apps to keep all the same (package names, split by spaces; Enter: none)" "" ""
        for s in $ANSWER; do
          [[ $s =~ ^[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z][A-Za-z0-9_]*)+$ ]] || { warn "$s is not a package name (like com.example.bank): left out"; continue; }
          plan_add "android strict keep" "$(nix_str "$s")" "" "kept though no list has them" "Strict keeps $s"
        done ;;
      d) plan_set "android strict enable" false "apps installed by hand stay" "Not strict: apps installed by hand stay" ;;
    esac
  fi

  page "Reaching the phone" "adb and SSH, from this computer and others: over USB, Wi-Fi or Tailscale."
  question "adb over the network, from each start of the phone?" \
    "With a port (5555 is adb's own), adb connect <phone>:5555 works over Wi-Fi or Tailscale, with no cable and no pairing. Only computers the phone lets in can use it: the trusted ones, or one you allow on its screen." \
    "$(now_value "android adb port" "off (Nixup's default)")"
  if editable "android adb port" set; then
    eds
    case $KEY in
      e)
        while :; do
          ask "Port" 5555
          [[ $ANSWER =~ ^[0-9]+$ ]] && ((ANSWER >= 1 && ANSWER <= 65535)) && break
          warn "A port is a number from 1 to 65535."
        done
        plan_set "android adb port" "$ANSWER" "adb connect <phone>:$ANSWER, from boot on" "adb over the network on port $ANSWER" ;;
      d) plan_set "android adb port" null "adb over USB only" "adb over USB only" ;;
    esac
  fi
  if [[ -f $HOME/.android/adbkey.pub ]]; then
    key="$(head -n 1 "$HOME/.android/adbkey.pub")"
    if list_has "android adb trustedKeys" "$key"; then
      say ""
      ok "This computer's adb key is trusted already (android.adb.trustedKeys)."
    elif editable "android adb trustedKeys" add; then
      question "Let this computer in without asking?" \
        "Adds this computer's adb key (~/.android/adbkey.pub) to android.adb.trustedKeys: the phone lets it in without asking \"Allow USB debugging?\", also after Android forgets it (unused for 7 days) or its adb keys are reset."
      key as s "${c_acc}a${c_r} add it  ${c_acc}s${c_r} skip ${c_d}(Enter)${c_r}"
      if [[ $KEY == a ]]; then
        answered "${c_ok}add it"
        plan_add "android adb trustedKeys" "$(nix_str "$key")" "" "computers let in without asking" "This computer's adb key is trusted"
      else
        answered "${c_d}skip"
      fi
    fi
  fi

  question "An SSH server on the phone?" \
    "ssh root@<phone> gets root's shell, with the config's Nix packages, as the app's terminal has it; it lets in keys only. Through Tailscale it reaches the phone from anywhere." \
    "$(now_bool "services openssh enable" on off false)"
  if editable "services openssh enable" set; then
    eds
    case $KEY in
      e)
        plan_set "services openssh enable" true "sshd, at boot and with each build" "SSH server on"
        key_file=""
        for t in id_ed25519 id_ecdsa id_rsa; do [[ -f $HOME/.ssh/$t.pub ]] && { key_file=$HOME/.ssh/$t.pub; break; }; done
        if [[ -n $key_file ]]; then
          key="$(head -n 1 "$key_file")"
          if list_has "users users root openssh authorizedKeys keys" "$key"; then
            ok "This computer's SSH key ($(pretty "$key_file")) is let in already."
          elif confirm "Let this computer's SSH key in ($(pretty "$key_file"))?" y; then
            plan_add "users users root openssh authorizedKeys keys" "$(nix_str "$key")" "" "public keys that log in as root" "This computer's SSH key logs in as root"
          fi
        else
          note "(No SSH key here, in ~/.ssh: users.users.root.openssh.authorizedKeys.keys takes your public keys.)"
        fi
        if editable "services openssh listenAddresses" set; then
          say "    ${c_b}Who reaches it?${c_r}"
          key ta t "${c_acc}t${c_r} only the tailnet, through Tailscale (127.0.0.1) ${c_d}(Enter)${c_r}  ${c_acc}a${c_r} any network, Wi-Fi too"
          if [[ $KEY == t ]]; then
            answered "the tailnet only"
            plan_set "services openssh listenAddresses" '[ { addr = "127.0.0.1"; port = 22; } ]' "127.0.0.1: the tailnet reaches it, Wi-Fi does not" "SSH listens for the tailnet only"
          else
            answered "any network"
            plan_set "services openssh listenAddresses" '[ ]' "every address: Wi-Fi reaches it too" "SSH listens on every network"
          fi
        fi ;;
      d) plan_set "services openssh enable" false "no SSH server" "SSH server off" ;;
    esac
  fi

  question "Tailscale, run by Nixup?" \
    "Joins the phone to your tailnet, run by root next to the Tailscale app (no VPN slot taken): the phone, its adb and its SSH server can then be reached from your other devices, anywhere." \
    "$(now_bool "services tailscale enable" on off false)"
  if editable "services tailscale enable" set; then
    eds
    case $KEY in
      e)
        plan_set "services tailscale enable" true "Tailscale, run by root" "Tailscale on"
        if editable "services tailscale authKeyFile" set; then
          secret "Auth key (tskey-…), so it logs in by itself; Enter: none (it logs in with a link, which its log shows)"
          if [[ $ANSWER == tskey-* ]]; then
            plan_file tailscale.key "$ANSWER"
            plan_set "services tailscale authKeyFile" ./tailscale.key "secret: logs in by itself" "Tailscale logs in with the key in ./tailscale.key"
          elif [[ -n $ANSWER ]]; then
            warn "That is not a Tailscale auth key (tskey-…): left out."
          fi
        fi ;;
      d) plan_set "services tailscale enable" false "no Tailscale of Nixup's" "Tailscale off" ;;
    esac
  fi

  page "Notifications and sync" "Messages from ntfy, calendars and contacts, and Syncthing: each one a service the phone runs."
  question "Notifications from ntfy topics, with no ntfy app?" \
    "The phone listens to topics and shows each message as a notification: send one from anywhere with curl -d \"Backup done\" ntfy.sh/<topic>. Anyone who knows a topic's name on ntfy.sh can read it: pick one nobody guesses." \
    "$(now_bool "services ntfy enable" on off false)"
  if editable "services ntfy enable" set; then
    eds
    case $KEY in
      e)
        plan_set "services ntfy enable" true "listens to the topics" "ntfy notifications on"
        t="phone-$(LC_ALL=C tr -dc 'a-z0-9' < /dev/urandom 2> /dev/null | head -c 6 || true)"
        ask "Topics, split by spaces (a name on ntfy.sh, or host/topic)" "$t"
        for s in $ANSWER; do
          plan_add "services ntfy topics" "$(nix_str "$s")" "" "the topics it listens to" "ntfy topic: $s"
        done
        if confirm "Also be the UnifiedPush distributor, for Element and others?" n; then
          plan_set "services ntfy unifiedPush enable" true "apps pick Nixup for their pushes" "Nixup is the UnifiedPush distributor"
        fi ;;
      d) plan_set "services ntfy enable" false "no ntfy topics" "ntfy notifications off" ;;
    esac
  fi

  question "Calendars and contacts from a CalDAV/CardDAV server?" \
    "Nixup's app syncs them into Android's Calendar and Contacts itself (DAVx⁵'s sync, no DAVx⁵ app): Nextcloud, Radicale, Baïkal, Fastmail, …" \
    "$(now_bool "services caldav enable" on off false)"
  if editable "services caldav enable" set; then
    eds
    case $KEY in
      e)
        plan_set "services caldav enable" true "the accounts, synced both ways" "Calendars and contacts synced"
        ask "The server's address (Enter: none, add accounts by hand)" "" ""
        if [[ -n $ANSWER ]]; then
          t=$ANSWER
          ask "Your user name on it" "${USER:-}"
          s=$ANSWER
          secret "Its password (kept in ./dav-password, next to the config)"
          if [[ -n $ANSWER ]]; then
            plan_file dav-password "$ANSWER"
            plan_set "services caldav accounts main" "{
  url = $(nix_str "$t");
  userName = $(nix_str "$s");
  passwordFile = ./dav-password;
}" "an account (secret: ./dav-password)" "CalDAV account: $s at $t"
          fi
        fi ;;
      d) plan_set "services caldav enable" false "no calendars and contacts sync" "Calendars and contacts not synced" ;;
    esac
  fi

  question "Syncthing?" \
    "Syncthing, run by root, set up from the config: its devices and folders are services.syncthing.settings, which the template has an example of." \
    "$(now_bool "services syncthing enable" on off false)"
  if editable "services syncthing enable" set; then
    eds
    case $KEY in
      e) plan_set "services syncthing enable" true "Syncthing, run by root (settings: its devices and folders)" "Syncthing on" ;;
      d) plan_set "services syncthing enable" false "no Syncthing" "Syncthing off" ;;
    esac
  fi

  page "Backups" "The phone backs up apps (their APK and data) and folders itself, encrypted, into a restic repository."
  question "Back up the phone's apps?" \
    "Each listed app is backed up after it was used; a build that installs one brings its data back. The repository can be on an SD card, or a server (sftp:, rest:, s3:, …)." \
    "$(now_value "android backup repository" "off (Nixup's default)")"
  if editable "android backup repository" set; then
    eds
    case $KEY in
      e)
        while :; do
          ask "Where (a folder like /storage/<card>/Backup, or sftp:you@pc:/backups/phone)" ""
          [[ -z $ANSWER ]] || break
        done
        plan_set "android backup repository" "$(nix_str "$ANSWER")" "the restic repository" "Backups go to $ANSWER"
        secret "Its password (kept in ./backup-password: keep a copy off the phone)"
        if [[ -n $ANSWER ]]; then
          plan_file backup-password "$ANSWER"
          plan_set "android backup passwordFile" ./backup-password "secret: keep a copy off the phone" "The backups' password is in ./backup-password"
        else
          warn "No password: android.backup.passwordFile needs one before the first backup."
        fi
        ids=()
        for s in "${SOURCES[@]}"; do
          [[ -n ${SRC_IDS[$s]} ]] || continue
          mapfile -t -O "${#ids[@]}" ids < <(printf '%s\n' "${SRC_IDS[$s]}" | tr '\037' '\n')
        done
        if ((PLAY_LIST)); then ids+=("${play[@]}"); fi
        if ((${#ids[@]})) && confirm "Back up all ${#ids[@]} apps of the config?" y; then
          for s in "${ids[@]}"; do plan_add "android backup apps" "$(nix_str "$s")" "" "apps backed up, with the defaults" ""; done
          PLAN_SAY[${#PLAN_SAY[@]} - 1]="${#ids[@]} apps are backed up"
        else
          ask "Apps to back up (package names, split by spaces; Enter: none for now)" "" ""
          for s in $ANSWER; do plan_add "android backup apps" "$(nix_str "$s")" "" "apps backed up, with the defaults" "$s is backed up"; done
        fi
        if confirm "A new phone: bring each app's data back by itself, when a build installs it?" n; then
          plan_set "android backup defaults autoRestore" true "data back when a build installs an app" "Data comes back by itself on a new phone"
        fi ;;
      d) plan_set "android backup repository" null "no backups" "No backups" ;;
    esac
  fi

  page "Terminal and Nix" "The Linux programs of the app's terminal (and ssh, and su -c nixup-shell), from nixpkgs."
  question "Nix packages for the terminal?" \
    "Programs from nixpkgs for root's shell, by their names in nixpkgs (search.nixos.org): htop git vim rsync python3 ffmpeg … Each is looked up before it goes in, as the phone gets it: built for 64-bit ARM, and in cache.nixos.org, since the phone builds no package itself." \
    "$(now_value "environment systemPackages" "none")"
  if editable "environment systemPackages" add; then
    passed=""
    while :; do
      if [[ -n $passed ]]; then ask "Packages to add, split by spaces (Enter: the ones that passed)" "$passed"
      else ask "Packages to add, split by spaces (Enter: none)" "" ""; fi
      read -ra names <<< "${ANSWER//,/ }"
      ((${#names[@]})) || break
      status=0
      check_packages "${names[@]}" || status=$?
      if ((status == 2)); then
        confirm "Add them without looking them up? (a dry run on the phone looks them up)" n || break
        PKGS_OK=("${names[@]}") status=0
      fi
      if ((status == 0)); then
        for s in "${PKGS_OK[@]}"; do
          plan_add "environment systemPackages" "$(pkg_item "$s")" "with pkgs; " "Nix packages of root's shell" "Nix package: $s"
        done
        break
      fi
      # One cannot go on the phone (why is under it): the names again, or Enter for the ones that passed.
      passed="${PKGS_OK[*]}"
      note "Type them again, with the ones above changed or left out (search.nixos.org has nixpkgs' packages, and the systems each one is for). Enter: ${passed:-none of them}." 4
    done
  fi
  question "Free up space by itself?" \
    "Every night (at 03:15) Nix removes the packages that no build of the phone uses any more, as NixOS's nix.gc." \
    "$(now_bool "nix gc automatic" on off false)"
  if editable "nix gc automatic" set; then
    eds
    case $KEY in
      e) plan_set "nix gc automatic" true "removes what nothing uses, at 03:15" "Space is freed up every night" ;;
      d) plan_set "nix gc automatic" false "nothing removed by itself" "Space is freed up by hand only" ;;
    esac
  fi

  if [[ $mode == create && ! -f $CFG_DIR/flake.nix ]]; then
    page "The config itself" "configuration.nix is the config either way; a flake.nix next to it pins what it is built with."
    question "A flake.nix too?" \
      "As /etc/nixos/flake.nix for NixOS: Nixup's version is pinned in flake.lock (a build with Upgrade moves it on), and other flakes can be its inputs. Without it, the phone builds configuration.nix with the newest Nixup and nixpkgs."
    key yn n "${c_acc}y${c_r} yes  ${c_acc}n${c_r} no ${c_d}(Enter)${c_r}"
    if [[ $KEY == y ]]; then answered yes; MAKE_FLAKE=1; else answered no; fi
  fi
  return 0
}

# review <before> <after> <dir>: the answers in words, what nixup could not change, and the change itself.
review() {
  local k files=() names=()
  say ""
  panel "Your answers"
  if ((${#PLAN_OP[@]} == 0)); then row "${c_d}(none: every question was skipped)${c_r}"; fi
  for k in "${!PLAN_OP[@]}"; do
    if [[ -n ${DROPPED[$k]:-} ]]; then
      read -ra names <<< "${PLAN_PATH[k]}"
      row "${c_warn}${s_warn}${c_r} $(nix_attrpath "${names[@]}"): ${DROPPED[$k]}"
    elif [[ -n ${PLAN_SAY[k]} ]]; then
      row "${c_ok}${s_ok}${c_r} ${PLAN_SAY[k]}"
    fi
  done
  for k in "${!PLAN_FILES[@]}"; do files+=("${PLAN_FILES[k]}"); done
  if ((${#files[@]})); then row "${c_ok}${s_ok}${c_r} Secret files, readable by you alone: ${files[*]}"; fi
  ((MAKE_FLAKE == 0)) || row "${c_ok}${s_ok}${c_r} flake.nix, named after the phone"
  panel_end
  if ! cmp -s "$1" "$2"; then
    say ""
    say "  ${c_b}The change to $(basename "${CFG_FILE:-configuration.nix}")${c_r}"
    show_diff "$1" "$2"
  fi
}

# write_config <after> <file> [phone name]: the config into its file (the one there kept as <file>.old), the secret
# files next to it, and flake.nix when one was asked for (create).
write_config() {
  local after=$1 file=$2 name=${3:-} dir k f git_root
  local -a secrets=()
  dir="$(dirname "$file")"
  mkdir -p "$dir"
  if [[ -f $file ]] && ! cmp -s "$after" "$file"; then
    cp -p "$file" "$file.old"
    ok "The old one: $(pretty "$file.old")"
  fi
  cat "$after" > "$file"
  ok "Wrote $(pretty "$file")"
  for k in "${!PLAN_FILES[@]}"; do
    f=$dir/${PLAN_FILES[k]}
    (umask 077; cp "${PLAN_FILE_FROM[k]}" "$f"; chmod 600 "$f")
    ok "Wrote $(pretty "$f") (secret: readable by you alone)"
    secrets+=("${PLAN_FILES[k]}")
  done
  if ((${#secrets[@]})); then
    git_root="$(git -C "$dir" rev-parse --show-toplevel 2> /dev/null || true)"
    if [[ -n $git_root && -n $CFG_FLAKE ]]; then
      warn "A flake in git sees only the files git tracks: git add ${secrets[*]} for its builds to find them, and keep that repository private."
    elif [[ -n $git_root ]]; then
      warn "The folder is in git: keep ${secrets[*]} out of a repository others can read."
    fi
  fi
  if ((MAKE_FLAKE)) && [[ ! -f $dir/flake.nix ]]; then
    flake_text "${name:-phone}" "$(basename "$file")" > "$dir/flake.nix"
    ok "Wrote $(pretty "$dir/flake.nix") (its configuration: \"${name:-phone}\")"
  fi
  remember_config "$file"
}
# A flake.nix for the phone named $1, made from its file $2, as Nixup's template has it.
flake_text() {
  local attr module=${2:-configuration.nix}
  attr="$(nix_attrpath "$1")"
  cat << EOF
# This phone's config as a flake, as /etc/nixos/flake.nix is for NixOS: Nixup's options come
# from github:by-architect/Nixup, at the version flake.lock pins (a build with update moves
# it to the newest). With this flake.nix picked in the app's Config, a build reads it;
# $module is the config either way.
{
  description = $(nix_str "$1, configured by Nixup");

  inputs.nixup.url = "github:by-architect/Nixup";

  outputs = { nixup, ... }: {
    # Named after the phone (its device name): with more phones here, each builds its own.
    nixupConfigurations.$attr = nixup.lib.nixupSystem {
      modules = [ ./$module ];
    };
  };
}
EOF
}

# answer_and_write <create|edit> <stage> <target> <before> <step> <steps>: the questions (step <step> of the flow's
# <steps>), then the change made, checked and shown (the next step), and written into <target> when you say so. The
# stage is the file being changed, next to the target (so relative paths in it hold); <before> is the file as it was.
answer_and_write() {
  local mode=$1 stage=$2 target=$3 before=$4 status k was
  local -a paths=()
  while :; do
    paths=()
    step "$5" "$6" "The questions"
    note "About what a phone cannot tell. Each says what its option does and what the config has now; Enter skips it, which leaves the option as it is. Nothing is written before you have seen the change." 4
    questions "$mode" "$stage" || return 1
    step $(($5 + 1)) "$6" "Look it over, and write it"
    cp "$stage" "$WORK/start.nix"
    if ((PLAY_LIST)); then play_list "$WORK/start.nix" > "$stage"; fi
    say ""
    say "  ${c_d}Making the change, and checking it with Nixup's options…${c_r}"
    apply_plan "$stage" "$WORK/after.nix" || return 1
    cp "$WORK/start.nix" "$stage"
    cp "$WORK/after.nix" "$stage.check"
    for k in "${!PLAN_OP[@]}"; do [[ -n ${DROPPED[$k]:-} ]] || paths+=("${PLAN_PATH[k]}"); done
    status=0
    if ((${#paths[@]})); then check_config "$stage.check" no "${paths[@]}" || status=$?; fi
    if ((status == 1)); then
      # The config before the change too? Then it is the config, not the change: it cannot be evaluated here. (A
      # flake's configuration as it is; and two modules of the same file, the flake's and the changed copy's imports,
      # are the swap's own doing, not the change's.)
      cp "$WORK/check.err" "$WORK/check.change.err"
      was=$before
      [[ -z $CFG_NAME ]] || was=""
      if grep -q 'is already declared in' "$WORK/check.err"; then status=2
      elif check_config "$was" yes "${paths[@]}"; then status=3
      else status=2; fi
      cp "$WORK/check.change.err" "$WORK/check.err"
    fi
    if ((status == 3)); then
      review "$before" "$WORK/after.nix"
      bad "The change does not evaluate with Nixup's options:"
      check_error
      rm -f "$stage.check"
      confirm "Answer the questions again?" y || return 1
      continue
    fi
    rm -f "$stage.check"
    review "$before" "$WORK/after.nix"
    if [[ $mode == edit ]] && cmp -s "$before" "$WORK/after.nix" && ((${#PLAN_FILES[@]} == 0)); then
      say ""
      ok "Nothing changes: the config stays as it is."
      return 0
    fi
    if ((status == 2)) && [[ -n $CFG_NAME ]]; then
      warn "The config could not be evaluated here$(err_line "$WORK/check.err"): only the change's syntax was checked. A dry run checks the rest."
    elif ((status == 2)); then
      warn "This file cannot be evaluated alone here (it may need its flake's arguments)$(err_line "$WORK/check.err"): only its syntax was checked. A dry run checks the rest."
    elif ((${#paths[@]})) && [[ -n $CFG_NAME ]]; then
      ok "It evaluates in the flake's $CFG_NAME, with Nixup's options (and the flake's other modules)."
    elif ((${#paths[@]})); then
      ok "It evaluates with Nixup's options."
    fi
    say ""
    menu "Write it?" "write|Write it|into $(pretty "$target")" "again|Answer again|the questions from the start" "cancel|Cancel|nothing is written"
    case $PICKED in
      write) break ;;
      again) continue ;;
      *) return 1 ;;
    esac
  done
  write_config "$WORK/after.nix" "$target" "${PHONE_NAME:-$PHONE_MODEL}"
}

# --- The menu's steps. Each runs on its own (an error, or q, ends it and the menu comes back).

flow_create() {
  local target file dir default
  FLOW="Make a config from a phone"
  need nix "nix (https://nixos.org/download), which makes the config"
  step 1 5 "The phone"
  note "nixup reads the phone over adb: its settings, its apps and where each came from. That needs no root; with root it also finds the apps in the repositories the phone's Nixup has." 4
  ensure_phone || return 1

  step 2 5 "Where the config goes"
  note "A folder (the config is its configuration.nix), or the file itself, named as you like (like ~/Matrix/hosts/pixel/default.nix)." 4
  default=${CONFIG_PATH:-$PWD}
  [[ ! -f $default ]] || default="$(dirname "$default")"
  if [[ -f $default/configuration.nix ]]; then
    default=$PWD/$(printf '%s' "${PHONE_NAME:-${PHONE_MODEL:-phone}}" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | tr -cd 'a-z0-9._-')
  fi
  while :; do
    ask "The folder for the config, or its file" "$default" "$(pretty "$default")"
    target="$(full_path "$ANSWER")"
    if [[ $target == *.nix && ! -d $target ]]; then file=$target; else file=$target/configuration.nix; fi
    if [[ $(basename "$file") == flake.nix ]]; then
      warn "flake.nix is a flake's own file: the config goes in a file of its own, which the flake's modules name."
      continue
    fi
    if [[ -f $file ]]; then
      warn "$(pretty "$file") is there already."
      menu "" "edit|Change that one instead|it keeps all it says: nixup only asks its questions" \
        "over|Make a new one over it|from the phone; the old one is kept as $(basename "$file").old" "other|Pick another place|"
      case $PICKED in
        edit)
          resolve_config "$file" || die "nixup cannot read $(pretty "$file") as a config"
          CONFIG_PATH=$file
          save_state
          remember_config "$file"
          flow_edit_config
          return ;;
        over) break ;;
        other) continue ;;
        *) return 1 ;;
      esac
    fi
    break
  done
  dir="$(dirname "$file")"
  ok "$(pretty "$file")"

  step 3 5 "Reading the phone"
  note "nixup-config reads its settings, its apps and where each came from (F-Droid, IzzyOnDroid, Google Play, …), and writes a config that keeps the phone as it is: building it changes nothing on the phone." 4
  say ""
  if ! "$here/nixup-config" create --target-host "adb:$PHONE_SERIAL" --output "$WORK/made.nix" --force 2>&1 \
    | sed -e "s|$WORK/made.nix|it|g" -e '/^Look it over/d' | indent; then
    die "nixup-config could not read the phone (it says why above)"
  fi
  made_summary "$WORK/made.nix"

  # A new file is no flake's configuration yet (its flake's modules name it once you add it there): it is the file alone.
  CFG_FILE=$file CFG_DIR=$dir CFG_FLAKE="" CFG_ROOT="" CFG_REF="" CFG_CLI="" CFG_REL="" CFG_NIXUP="" CFG_NAME=""
  CFG_PHONES=() CFG_MACHINES=()
  stage_for "$file"
  cp "$WORK/made.nix" "$STAGE"
  CONFIG_PATH=$file
  save_state

  if ! answer_and_write create "$STAGE" "$file" "$WORK/made.nix" 4 5; then
    say ""
    warn "Nothing was written."
    return 1
  fi
  resolve_config "$file" || true
  look_config
  say ""
  note "Build it on the phone to make the phone follow it: with a dry run first, nothing changes, and it shows what a build would change (it should be nothing, but your answers)." 2
  menu "Build it now?" "dry|Dry run on the phone|what a build would change; nothing changes" "build|Build it|choose how, then the phone follows the config" "no|Not now|"
  case $PICKED in
    dry) require_module && BUILD_PRESET=dry flow_build_config 1 ;;
    build) require_module && flow_build_config 1 ;;
  esac
}

# What nixup-config found, in a panel.
made_summary() {
  local kind name count apps="" settings=0 removed=0 disabled=0 from_play=0 other=0 obtainium=0
  while read -r kind name count; do
    case $kind in
      app) apps+="$(source_name "$name") $count, " ;;
      settings) settings=$name ;;
      removed) removed=$name ;;
      disabled) disabled=$name ;;
      play) from_play=$name ;;
      obtainium) obtainium=$name ;;
      other) other=$name ;;
    esac
  done < <(awk '
    /^  # ==== / { part = $0 }
    /^  android\.packages\.[A-Za-z0-9_-]+ = \[/ { src = $1; sub(/^android\.packages\./, "", src); next }
    src != "" && /^    "/ { apps[src]++; next }
    src != "" && /^  \];/ { src = ""; next }
    /^  # From Google Play:/ { block = "play" }
    /^  # From Obtainium:/ { block = "obtainium" }
    /^  # Not found in/ { block = "other" }
    /^  #   "/ { if (block != "") n[block]++; next }
    /^$/ { block = "" }
    part ~ /phone.s settings/ && /^  [a-z]/ { settings++ }
    /debloat = true;/ { removed++ }
    /enabled = false;/ { disabled++ }
    END {
      for (s in apps) printf "app %s %d\n", s, apps[s]
      printf "settings %d\nremoved %d\ndisabled %d\n", settings, removed, disabled
      for (b in n) printf "%s %d\n", b, n[b]
    }' "$1")
  say ""
  panel "What nixup-config found"
  if [[ -n $apps ]]; then kv "apps" "${apps%, }"; else kv "apps" "${c_d}none from the repositories it knows${c_r}"; fi
  ((from_play == 0)) || kv "" "${c_warn}${from_play} from Google Play${c_r} ${c_d}(asked about next)${c_r}"
  ((obtainium == 0)) || kv "" "${c_d}${obtainium} from Obtainium: comments in the config (each needs its releases' page)${c_r}"
  ((other == 0)) || kv "" "${c_d}${other} found in no repository: comments in the config${c_r}"
  kv "settings" "$settings"
  kv "system apps" "$removed removed for you, $disabled disabled"
  panel_end
}

flow_edit() {
  FLOW="Change a config"
  need nix "nix (https://nixos.org/download), which reads and checks the config"
  step 1 3 "Which config"
  note "Its file (configuration.nix, a host's default.nix, any), or a folder with one. When the file is part of a flake, the flake is read too: what its other modules set, and the Nixup its flake.lock pins." 4
  pick_config "The config (a file, or its folder)" "${CONFIG_PATH:-$PWD}"
  flow_edit_config
}
# flow_edit_config: the config (resolve_config's) changed by answering the questions.
flow_edit_config() {
  FLOW="Change a config"
  [[ -n $CFG_FILE ]] || die "$(pretty "$CFG_FLAKE") is a flake.nix, which names the files its configurations are made of: give the one to change (its configuration.nix, or a host's default.nix)"
  look_config
  stage_for "$CFG_FILE"
  cp "$CFG_FILE" "$STAGE"
  if ! answer_and_write edit "$STAGE" "$CFG_FILE" "$CFG_FILE" 2 3; then
    say ""
    warn "Nothing was written."
    return 1
  fi
}

flow_build() {
  FLOW="Build a config on a phone"
  step 1 4 "The phone"
  note "The phone needs root (Magisk letting Shell use it) and Nixup's module." 4
  ensure_phone module || return 1
  step 2 4 "The config"
  local -a items=()
  [[ -z $PHONE_SOURCE ]] || items+=("phone|The config the phone builds now|$PHONE_SOURCE")
  items=("config|A config on this computer|${CONFIG_PATH:+$(pretty "$CONFIG_PATH")}" "${items[@]}")
  menu "Which config?" "${items[@]}"
  case $PICKED in
    phone) build_run phone "" "" "" ;;
    config)
      pick_config "The config (a file, or its folder)" "${CONFIG_PATH:-$PWD}"
      flow_build_config 1 1 ;;
    *) return 1 ;;
  esac
}
# flow_build_config [1: the phone was picked already] [1: and this step's title shown]: the config (resolve_config's)
# built on the phone: the flake's configuration made from the file, a flake.nix's phone, or the file alone.
flow_build_config() {
  local dir file name="" where mode phone_folder="" alone=0 n why=""
  local -a items=()
  FLOW="Build a config on a phone"
  if [[ ${1:-} != 1 ]]; then
    step 1 4 "The phone"
    ensure_phone module || return 1
  fi
  [[ ${2:-} == 1 ]] || step 2 4 "The config"
  look_config
  # Next to its flake.nix (Nixup's own layout), the file can be built alone too.
  if [[ -n $CFG_FILE && -n $CFG_NAME && $CFG_DIR == "$CFG_ROOT" ]]; then
    menu "Build which?" "flake|The flake's $CFG_NAME|with the inputs its flake.lock pins" \
      "file|$(basename "$CFG_FILE") alone|with the newest Nixup and nixpkgs (no flake.lock)"
    case $PICKED in flake) ;; file) alone=1 ;; *) return 1 ;; esac
  fi
  if [[ -n $CFG_FILE ]] && [[ -z $CFG_NAME || $alone == 1 ]]; then
    dir=$CFG_DIR file="$(basename "$CFG_FILE")"
  else
    dir=$CFG_ROOT file=flake.nix name=$CFG_NAME
    if [[ -z $name ]]; then
      ((${#CFG_PHONES[@]})) || die "$(pretty "$CFG_FLAKE") makes no phone's config (it has no nixupConfigurations)"
      if ((${#CFG_PHONES[@]} == 1)); then
        name=${CFG_PHONES[0]}
      else
        for n in "${CFG_PHONES[@]}"; do
          if [[ $n == "$PHONE_NAME" ]]; then items=("$n|$n|named after this phone" "${items[@]}"); else items+=("$n|$n|"); fi
        done
        menu "Which of its phones?" "${items[@]}"
        [[ $PICKED != back ]] || return 1
        name=$PICKED
      fi
    fi
  fi
  ok "$(pretty "$dir/$file")${name:+ → $name}"

  step 3 4 "How"
  # On the phone, the folder goes into its storage: only a folder of the config's own, with all it needs in it.
  if [[ $file == flake.nix && $CFG_ROOT != "$CFG_DIR" && -n $CFG_FILE ]]; then
    why="its flake is $(pretty "$CFG_ROOT"), with more in it than this config (all of it would go into the phone's storage: other machines' files and secrets too)"
  elif ((${CFG_OUTSIDE:-0})); then
    why="it names files outside its folder (../), which a copy of its folder has not got"
  fi
  if ! command -v nix > /dev/null; then
    [[ -z $why ]] || die "it cannot be built on the phone ($why), and there is no nix here to build it"
    note "(There is no nix here, so the phone builds it: the folder is copied into its storage first.)" 4
    PICKED=phone
  elif [[ -n $why ]]; then
    note "It is built on this computer: $why." 4
    PICKED=pc
  else
    menu "Where is it built?" \
      "pc|On this computer|nixup-rebuild: Nix here builds it, the phone applies it; secrets go straight to root" \
      "phone|On the phone|the folder is copied into the phone's storage, and the phone builds it"
  fi
  case $PICKED in pc | phone) where=$PICKED ;; *) return 1 ;; esac
  if [[ -n ${BUILD_PRESET:-} ]]; then
    mode=$BUILD_PRESET
  else
    menu "What should it do?" "switch|Build and apply|switch: the phone becomes what the config says" \
      "dry|Dry run|only show what a build would change; nothing changes" \
      "update|Upgrade|build and apply with everything at its newest (indexes, releases, a flake's inputs)"
    case $PICKED in switch | dry | update) mode=$PICKED ;; *) return 1 ;; esac
  fi
  if [[ $where == phone && $mode != dry ]]; then
    note "The folder is copied into the phone's storage, which the phone builds from then on (the app's Config shows it). Its files, secrets too, are where apps with storage access can read them; built on this computer, secrets go to root's folder alone." 4
    phone_folder_ask || return 1
    phone_folder=$PHONE_FOLDER
  fi
  build_run "$where" "$dir" "$file" "$name" "$mode" "$phone_folder"
}

# The folder on the phone a config is copied into, in PHONE_FOLDER: by default the one the phone builds from now.
phone_folder_ask() {
  local default=/storage/emulated/0/Nixup picked inside
  picked=${PHONE_SOURCE%%#*}
  [[ $picked != /storage/* ]] || default=${picked%/*}
  while :; do
    ask "The folder on the phone (what is in it is replaced)" "$default"
    PHONE_FOLDER=${ANSWER%/}
    [[ $PHONE_FOLDER != /sdcard/* ]] || PHONE_FOLDER=/storage/emulated/0/${PHONE_FOLDER#/sdcard/}
    if [[ $PHONE_FOLDER == *[\'\"\$\`\\]* ]]; then warn "It cannot have quotes, \$, \` or \\ in its name."; continue; fi
    case $PHONE_FOLDER in
      /storage/emulated/0/?*) inside=${PHONE_FOLDER#/storage/emulated/0/} ;;
      /storage/emulated/*) inside="" ;;
      /storage/*/?*) inside=${PHONE_FOLDER#/storage/*/} ;;
      *) inside="" ;;
    esac
    if [[ -z $inside ]]; then warn "It must be inside the phone's storage or an SD card, like /storage/emulated/0/Nixup."; continue; fi
    case $inside in
      Download | Documents | DCIM | Pictures | Movies | Music | Android | Alarms | Notifications | Podcasts | Ringtones | Recordings | Audiobooks)
        warn "$PHONE_FOLDER is a folder Android keeps for everything: give the config one of its own, like $PHONE_FOLDER/Nixup."
        continue ;;
    esac
    break
  done
}

# build_run <pc|phone> <dir> <file> <name> <mode> [phone folder]: the build, after a last look at what it does.
build_run() {
  local where=$1 dir=$2 file=$3 name=$4 mode=${5:-} phone_folder=${6:-} what status=0
  local -a args=()
  if [[ $where == phone && -z $dir && -z $mode ]]; then
    step 3 4 "How"
    menu "What should it do?" "switch|Build and apply|switch: the phone becomes what its config says" \
      "dry|Dry run|only show what a build would change; nothing changes" \
      "update|Upgrade|build and apply with everything at its newest (indexes, releases, a flake's inputs)"
    case $PICKED in switch | dry | update) mode=$PICKED ;; *) return 1 ;; esac
  fi
  case $mode in
    switch) what="build it and apply it" ;;
    dry) what="a dry run: show what a build would change, change nothing" ;;
    update) what="upgrade: build and apply it with everything at its newest" ;;
  esac
  # On this computer: nixup-rebuild, with the flake's configuration (as nixup-rebuild takes a flake: its submodules too)
  # or the file alone.
  if [[ $where == pc && -n $dir ]]; then
    case $mode in switch) args=(switch) ;; dry) args=(dry-activate) ;; update) args=(switch --upgrade) ;; esac
    args+=(--target-host "adb:$PHONE_SERIAL")
    if [[ $file == flake.nix ]]; then args+=(--flake "${CFG_CLI:-$dir}${name:+#$name}"); else args+=(--file "$dir/$file"); fi
  fi
  step 4 4 "Build"
  panel "Ready"
  kv Phone "${PHONE_MODEL:-the phone} ($PHONE_SERIAL)"
  if [[ -z $dir ]]; then
    kv Config "the one the phone builds now: $PHONE_SOURCE"
    kv Where "on the phone"
  else
    kv Config "$(pretty "$dir/$file")${name:+ → $name}"
    if [[ $where == pc ]]; then kv Where "on this computer (nixup-rebuild), applied on the phone"
    elif [[ $mode == dry ]]; then kv Where "on the phone, from a copy of the folder that it keeps for this run only"
    else kv Where "on the phone, from $phone_folder (copied there; the phone builds it from now on)"; fi
  fi
  kv Does "$what"
  ((${#args[@]} == 0)) || kv Runs "nixup-rebuild $(printf '%q ' "${args[@]}")"
  panel_end
  confirm "Start?" y || return 1
  say ""
  say "  ${c_d}$(rule $((COLS - 4)))${c_r}"
  in_step=1
  if [[ -z $dir ]]; then
    module_run "sh \$d/build.sh adb $mode" || status=$?
  elif [[ $where == pc ]]; then
    "$here/nixup-rebuild" "${args[@]}" || status=$?
  else
    phone_copy_build "$dir" "$file" "$name" "$mode" "$phone_folder" || status=$?
  fi
  say "  ${c_d}$(rule $((COLS - 4)))${c_r}"
  phone_facts > /dev/null 2>&1 || true
  if ((status == 0)); then
    say ""
    case $mode in
      dry) ok "The dry run is done: what a build would change is above (nothing was changed)." ;;
      *) ok "Built: the phone follows the config now (generation ${PHONE_GEN:-?})." ;;
    esac
    return 0
  fi
  say ""
  bad "The build stopped (status $status): why is above."
  if [[ $where == phone || -z $dir ]] && confirm "Show the end of the phone's log of it?" y; then
    phone_root 'f=$(ls -t /data/adb/nixup/logs/*-build-*.log 2> /dev/null | head -n 1); [ -n "$f" ] && { echo "$f"; tail -n 40 "$f"; }' | indent || true
  fi
  return 1
}

# The folder copied into the phone (a dry run: into a folder of its own, for that run only; else into phone_folder,
# then made the config the phone builds), and built there with the module's build.sh, as its Build button does.
phone_copy_build() {
  local dir=$1 file=$2 name=$3 mode=$4 target=$5 staged=$WORK/push status=0
  rm -rf "$staged"
  mkdir -p "$staged"
  # Hidden files (.git) and result links stay here.
  tar -C "$dir" --exclude='./.*' --exclude='./result*' -cf - . | tar -C "$staged" -xf -
  [[ -f $staged/$file ]] || die "could not gather the folder's files"
  adb -s "$PHONE_SERIAL" shell "rm -rf /data/local/tmp/nixup-config /data/local/tmp/nixup-config.sh" < /dev/null
  adb -s "$PHONE_SERIAL" push "$staged" /data/local/tmp/nixup-config > /dev/null || die "could not copy the folder to the phone"
  if [[ $mode == dry ]]; then
    say "  ${c_d}A dry run of a copy of the folder, which goes when it is done${c_r}"
    module_run "sh \$d/build.sh adb dry --source=$(phone_quote "/data/local/tmp/nixup-config/$file${name:+#$name}"); s=\$?; rm -rf /data/local/tmp/nixup-config; exit \$s" || status=$?
    return "$status"
  fi
  # On the phone, as root: the copy checked; the folder there (unless it is too big to be the config's own) kept, then
  # replaced, and what it had put back should that fail; and the copy made the config the phone builds. (The file's
  # name and the configuration's, quoted: a phone's name can be anything, like Neo's Pixel.)
  cat > "$WORK/replace.sh" << EOF
new=/data/local/tmp/nixup-config old=/data/adb/nixup/config.old target='$target'
file=$(phone_quote "$file") picked=$(phone_quote "$file${name:+#$name}")
[ -f "\$new/\$file" ] || exit 4
if [ -d "\$target" ]; then
  kb=\$(du -sk "\$target" | cut -f1)
  [ "\${kb:-0}" -le 51200 ] || exit 7
fi
mkdir -p /data/adb/nixup && rm -rf "\$old" && { [ ! -d "\$target" ] || cp -r "\$target" "\$old"; } || exit 5
if rm -rf "\$target" && mkdir -p "\${target%/*}" && cp -r "\$new" "\$target"; then rm -rf "\$new"; else rm -rf "\$target"; [ ! -d "\$old" ] || cp -r "\$old" "\$target"; exit 6; fi
printf '%s\n' "\$target/\$picked" > /data/adb/nixup/source && rm -f /data/adb/nixup/build-from
EOF
  adb -s "$PHONE_SERIAL" push "$WORK/replace.sh" /data/local/tmp/nixup-config.sh > /dev/null || die "could not copy the folder to the phone"
  phone_root "sh /data/local/tmp/nixup-config.sh" || status=$?
  adb -s "$PHONE_SERIAL" shell "rm -f /data/local/tmp/nixup-config.sh" < /dev/null || true
  case $status in
    0) ;;
    7) die "$target holds more than 50 MB, so it is not a folder of the config's own: give the config one (nothing was changed)" ;;
    *) die "could not put the folder in $target; the phone keeps the one it had" ;;
  esac
  say "  ${c_d}The phone builds $target/$file${name:+#$name} from now on (the app's Config shows it).${c_r}"
  module_run "sh \$d/build.sh adb $mode" || status=$?
  # The flake.lock the phone wrote (a flake's first build pins its inputs, an upgrade moves them) comes back.
  if [[ $file == flake.nix ]]; then
    phone_root_out "cat '$target/flake.lock' 2> /dev/null" > "$WORK/flake.lock" || true
    if grep -qs '"nodes"' "$WORK/flake.lock" && ! cmp -s "$WORK/flake.lock" "$dir/flake.lock"; then
      cp "$WORK/flake.lock" "$dir/flake.lock"
      say "  ${c_d}The flake.lock the phone wrote is in the folder now: $(pretty "$dir/flake.lock")${c_r}"
    fi
  fi
  return "$status"
}

flow_generations() {
  local out n when label from mark current="" prev="" mode=""
  local -a gens=() rows=()
  FLOW="Generations"
  step 1 3 "The phone"
  ensure_phone module || return 1
  step 2 3 "Its generations"
  note "Each build that changed the phone is a generation, as on NixOS. Going back to one applies it again as it was (its settings, apps and services), and it becomes the newest." 4
  out="$(phone_root 'g=/data/adb/nixup/generations; c=$(cat $g/last 2> /dev/null)
for n in $(ls $g 2> /dev/null | grep -x "[0-9][0-9]*" | sort -n); do
  w=$(stat -c %y $g/$n/profile.json 2> /dev/null | cut -c1-16)
  l=$(sed -n "s/^label=//p" $g/$n/version 2> /dev/null | head -n 1)
  f=$(head -n 1 $g/$n/source 2> /dev/null)
  m=-; [ "$n" = "$c" ] && m=current
  printf "%s\t%s\t%s\t%s\t%s\n" "$n" "${w:--}" "${l:--}" "${f:--}" "$m"
done' | tr -d '\r' || true)"
  while IFS=$'\t' read -r n when label from mark; do
    [[ $n =~ ^[0-9]+$ ]] || continue
    gens+=("$n")
    rows+=("$n"$'\t'"$when"$'\t'"$label"$'\t'"$from"$'\t'"$mark")
    [[ $mark != current ]] || current=$n
  done <<< "$out"
  ((${#gens[@]})) || die "${PHONE_MODEL:-the phone} has no generation yet: no build has been applied"
  # The one before the current one, as nixos-rebuild --rollback goes back to.
  for n in "${gens[@]}"; do
    if [[ -n $current ]] && ((n < current)); then prev=$n; fi
  done
  say ""
  printf '    %s%5s  %-16s  %-28s  %s%s\n' "$c_d" "#" "built" "label" "built from" "$c_r" >&2
  for n in "${rows[@]}"; do
    IFS=$'\t' read -r n when label from mark <<< "$n"
    if [[ $mark == current ]]; then
      printf '  %s%s %5s  %-16s  %-28s  %s%s %s(now)%s\n' "$c_acc" "$s_arrow" "$n" "$when" "${label:0:28}" "${from:0:$((COLS - 62))}" "$c_r" "$c_ok" "$c_r" >&2
    else
      printf '    %5s  %-16s  %-28s  %s\n' "$n" "$when" "${label:0:28}" "${from:0:$((COLS - 56))}" >&2
    fi
  done
  step 3 3 "Go back"
  local -a items=()
  [[ -z $prev ]] || items+=("prev|Back to generation $prev|the one before the current one, as nixos-rebuild --rollback")
  items+=("pick|Another generation|by its number" "try|Try one first|a dry run: what going to it would change, changing nothing")
  menu "What now?" "${items[@]}"
  case $PICKED in
    prev) n=$prev ;;
    pick | try)
      ask "Which generation (its number)" "$prev"
      n=$ANSWER
      [[ " ${gens[*]} " == *" $n "* ]] || die "there is no generation $n"
      [[ $PICKED != try ]] || mode=dry ;;
    *) return 1 ;;
  esac
  if [[ $mode == dry ]]; then confirm "Try generation $n (nothing changes)?" y || return 1
  else confirm "Go back to generation $n?" y || return 1; fi
  say ""
  module_run "sh \$d/build.sh adb generation $n${mode:+ $mode}" || die "going to generation $n stopped (why is above)"
  phone_facts > /dev/null 2>&1 || true
  if [[ $mode == dry ]]; then ok "That is what generation $n would change (nothing was changed)."
  else ok "The phone has generation $n's config again (now as generation ${PHONE_GEN:-?})."; fi
}

flow_play() {
  local p dir token account="" stage
  FLOW="Google Play sign-in"
  need curl "curl, which asks Google for the account's token"
  step 1 3 "Where the token goes"
  note "A Google account's token lets the phone download the config's Google Play apps with no sign-in on it. It acts as the account itself: it is kept next to the config's file, readable by you alone, and goes to the phone with each build." 4
  ask "The config (a file, or its folder)" "${CONFIG_PATH:-$PWD}" "$(pretty "${CONFIG_PATH:-$PWD}")"
  p="$(full_path "$ANSWER")"
  CFG_FILE="" CFG_NAME=""
  if [[ -e $p ]] && resolve_config "$p"; then
    CONFIG_PATH=$p
    save_state
    remember_config "$p"
    dir=$CFG_DIR
  else
    # No config there yet: the token alone, for one to come.
    [[ ! -f $p ]] || p="$(dirname "$p")"
    dir=$p
  fi
  mkdir -p "$dir"
  token=$dir/google-play.token
  step 2 3 "Sign in"
  note "A window with Google's own sign-in page opens (or your browser, with steps to follow). Better an account of its own: Google may block one that downloads with an unofficial client." 4
  say ""
  in_step=1
  play_sign_in "$token" || die "the sign-in did not finish (why is above)"
  account=$PLAY_ACCOUNT
  ok "Signed in to Google Play${account:+ as $account}: the token is in $(pretty "$token"), readable by you alone."
  if git -C "$dir" rev-parse --show-toplevel > /dev/null 2>&1; then
    warn "The folder is in git: keep google-play.token out of a repository others can read (a flake there sees it only once git tracks it)."
  fi
  step 3 3 "In the config"
  if [[ -z $CFG_FILE ]]; then
    note "There is no config's file there to put it in: one takes it with android.playstore.tokenFile = ./google-play.token;" 4
    return 0
  fi
  stage_for "$CFG_FILE"
  stage=$STAGE
  cp "$CFG_FILE" "$stage"
  look_options "$stage" || return 1
  plan_reset
  MAKE_FLAKE=0 PLAY_LIST=0
  editable "android playstore tokenFile" set || return 1
  plan_set "android playstore tokenFile" ./google-play.token "secret: no sign-in on the phone" "Google Play's token: ./google-play.token"
  if [[ -n $account ]] && editable "android playstore account" set; then
    plan_set "android playstore account" "$(nix_str "$account")" "builds stop if another account is signed in" "Google Play's account: $account"
  fi
  apply_plan "$stage" "$WORK/after.nix" || return 1
  if cmp -s "$CFG_FILE" "$WORK/after.nix"; then ok "The config has it already."; return 0; fi
  review "$CFG_FILE" "$WORK/after.nix"
  confirm "Put it in the config?" y || return 1
  write_config "$WORK/after.nix" "$CFG_FILE"
}

# --- The menu.
main_screen() {
  banner
  phone_rows
  config_row
  local tools=""
  tools+="adb $(command -v adb > /dev/null && yes_mark yes || yes_mark no)  "
  tools+="nix $(command -v nix > /dev/null && yes_mark yes || yes_mark no)  "
  tools+="curl $(command -v curl > /dev/null && yes_mark yes || yes_mark no)"
  kv "Here" "$tools"
  say ""
}
# run_step <flow>: one of the menu's steps, on its own: its error, Ctrl-C or q ends it, and the menu comes back.
run_step() {
  local status=0
  in_step=1
  ("$@") || status=$?
  in_step=0
  load_state
  if ((status == 130)); then say ""; warn "Stopped."; fi
  pause
}

CONFIG_PATH="$(first_config)"
save_state
if [[ $action != menu ]]; then
  in_step=1
  status=0
  case $action in
    create) (flow_create) || status=$? ;;
    edit) (flow_edit) || status=$? ;;
    build) (flow_build) || status=$? ;;
    generations) (flow_generations) || status=$? ;;
    play) (flow_play) || status=$? ;;
  esac
  exit "$status"
fi
while :; do
  load_state
  main_screen
  menu "What do you want to do?" \
    "create|Make a config from a phone|reads its apps and settings, then asks about the rest" \
    "edit|Change a config|updates, access, services, backups: answer the questions again" \
    "build|Build a config on a phone|apply it, built here or on the phone; or a dry run first" \
    "generations|Generations|the phone's builds so far; go back to an earlier one" \
    "play|Google Play sign-in|a token for the config, so the phone needs no sign-in" \
    "phone|Pick the phone|another phone, or one over the network" \
    "config|Pick the config|a file of any name, or a folder with one"
  case $PICKED in
    create) run_step flow_create ;;
    edit) run_step flow_edit ;;
    build) run_step flow_build ;;
    generations) run_step flow_generations ;;
    play) run_step flow_play ;;
    phone) in_step=1; (pick_phone) || true; in_step=0; load_state ;;
    config) in_step=1; (pick_config "The config (a file, or its folder)" "${CONFIG_PATH:-$PWD}") || pause; in_step=0; load_state ;;
    back) break ;;
  esac
done
say ""
