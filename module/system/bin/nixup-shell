#!/system/bin/sh
# nixup-shell: root's shell, or a command, in Nixup's view of the phone, where /nix exists and the config's
# environment.systemPackages are on PATH, as on any Linux with Nix. The app's terminal opens it, and an ssh session
# (services.openssh) gets the same one (/etc/nixup/login, which the engine writes):
#   su -c nixup-shell             a login shell (bash, when the config has Nix packages)
#   su -c 'nixup-shell htop'      one command
# The view is the one Nixup's services run in (Android's folders as they are, Nixup's /etc, /var and /run, a /tmp
# of its own); Android's own commands are on PATH too, after the config's. Before the config's first build there is
# no view yet: an interactive shell is then Android's own.
DATA=/data/adb/nixup
[ "$(id -u)" = 0 ] || { echo "nixup-shell: run it as root: su -c nixup-shell" >&2; exit 1; }
# A root shell an app starts (the app's terminal) sees the phone as the app does, without the other apps' data
# folders: this goes on in init's view of the phone (its mount namespace) instead, as adb's root shell has it.
if [ "$(readlink /proc/1/ns/mnt)" != "$(readlink /proc/self/ns/mnt)" ]; then
  for n in "/data/adb/magisk/busybox nsenter" "/data/adb/ksu/bin/busybox nsenter" "/data/adb/ap/bin/busybox nsenter" /system/bin/nsenter; do
    $n -t 1 -m -- true 2> /dev/null && exec $n -t 1 -m -- /system/bin/sh "$0" "$@"
  done
fi
busybox=
for b in /data/adb/magisk/busybox /data/adb/ksu/bin/busybox /data/adb/ap/bin/busybox; do
  [ -x "$b" ] && busybox=$b && break
done
# su -c gives its shell the terminal but not as its controlling one, without which a shell has no job control (and
# Ctrl+C reaches nothing): a session of its own takes it (busybox's setsid -c does; toybox's leaves it to another
# session). su's shell leads its process group, which cannot start a session, so a child of it does, and it waits.
if [ -t 0 ] && [ -z "$NIXUP_SHELL_TTY" ] && [ -n "$busybox" ] && ! (: < /dev/tty) 2> /dev/null; then
  export NIXUP_SHELL_TTY=1
  "$busybox" setsid -c /system/bin/sh "$0" "$@"
  exit $?
fi
if [ ! -f "$DATA/units/view.sh" ]; then
  [ $# -gt 0 ] && { echo "nixup-shell: build the config once first (Nixup makes its view then)" >&2; exit 1; }
  echo "nixup-shell: the config was not built yet, so this is Android's shell, without Nix packages" >&2
  cd "$DATA/home" 2> /dev/null || cd /
  exec /system/bin/sh -l
fi
quoted() { printf " '%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
script=$DATA/tmp/nixup-shell.$$
mkdir -p "$DATA/tmp"
{
  printf "export TERM='%s'\n" "${TERM:-xterm-256color}"
  # Root's shell, as the engine wrote it for the profile in place.
  echo 'if [ -x /etc/nixup/login ]; then'
  if [ $# -gt 0 ]; then
    # The command as it is, whatever root's shell is (users.defaultUserShell: fish's -c takes no sh); a login an older
    # engine wrote takes it through the shell's -c.
    if grep -q -- --nixup-exec "$DATA/etc/nixup/login" 2> /dev/null; then
      printf "  exec /etc/nixup/login --nixup-exec"
    else
      printf "  exec /etc/nixup/login -c 'exec \"\$0\" \"\$@\"'"
    fi
    for word; do quoted "$word"; done
    echo
  else
    echo '  exec /etc/nixup/login'
  fi
  echo 'fi'
  # An engine from before /etc/nixup/login: the profile's PATH and bash (none without environment.systemPackages).
  path=$(grep -o '"shell":{[^}]*}' "$DATA/profile.json" 2> /dev/null | grep -o '"path":"[^"]*"' | cut -d'"' -f4)
  bash=$(grep -o '"shell":{[^}]*}' "$DATA/profile.json" 2> /dev/null | grep -o '"bash":"[^"]*"' | cut -d'"' -f4)
  printf "export PATH='%s' HOME='%s'\n" "${path:-/system/bin}" "$DATA/home"
  echo "cd /"
  if [ $# -gt 0 ]; then
    printf 'exec'
    for word; do quoted "$word"; done
    echo
  else
    echo "exec ${bash:-/system/bin/sh} -i"
  fi
} > "$script"
"$busybox" sh "$DATA/units/view.sh" "$script"
status=$?
rm -f "$script"
exit $status
