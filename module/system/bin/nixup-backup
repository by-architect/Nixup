#!/system/bin/sh
# nixup-backup: the backups of the config's apps and folders (android.backup), by hand, as root:
#   nixup-backup list [app or folder]       the backups there are
#   nixup-backup status                     when each app and folder was backed up last, and whether it is due
#   nixup-backup now [apps or folders]      back up now: all of them, or the ones named, which may be any installed
#                                            app or folder (--parts=apk,data,deviceData,storage,media,obb: what to
#                                            take of each app, instead of its settings)
#   nixup-backup restore <app> [snapshot]   the app's data back from its newest backup (or the one named, from
#                                            list), over what it has, and its APK when it is not installed
#                                            (--parts=apk,data,...: the parts named; apk installs it from the backup)
#   nixup-backup restore <folder> [snapshot]
#                                            the folder's files back into it (--to=<folder>: into a new folder)
#   nixup-backup restic <arguments>         restic itself, with the repository and password (snapshots, check,
#                                            restore <id> --target /data/local/tmp/x, ...)
# The phone backs them up by itself too, as the config says (android.backup.defaults.when).
[ "$(id -u)" = 0 ] || { echo "nixup-backup: run it as root: su -c nixup-backup" >&2; exit 1; }
# A root shell an app starts (the app's terminal) sees the phone as the app does, without the other apps' data
# folders: this goes on in init's view of the phone (its mount namespace) instead, as adb's root shell has it.
if [ "$(readlink /proc/1/ns/mnt)" != "$(readlink /proc/self/ns/mnt)" ]; then
  for n in "/data/adb/magisk/busybox nsenter" "/data/adb/ksu/bin/busybox nsenter" "/data/adb/ap/bin/busybox nsenter" /system/bin/nsenter; do
    $n -t 1 -m -- true 2> /dev/null && exec $n -t 1 -m -- /system/bin/sh "$0" "$@"
  done
fi
d=/data/adb/modules_update/nixup
[ -f "$d/backup.sh" ] || d=/data/adb/modules/nixup
case "$1" in
  list | status | now | restore | restic) ;;
  "" | -h | --help | help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) echo "nixup-backup: no such command: $1 (list, status, now, restore, restic)" >&2; exit 1 ;;
esac
exec sh "$d/backup.sh" shell "$@"
