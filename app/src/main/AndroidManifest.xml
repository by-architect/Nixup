<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Notifications about installs and updates; the module also grants it when it installs the app. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The periodic update check stays scheduled across restarts, and waits for Wi-Fi. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The terminal's sessions keep running while it is closed, with a notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- The Backups tab lists the installed apps to back up by hand, with their names. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Google's sign-in page, for the Google Play account (the engine, as root, reaches the network by itself), and
         the CalDAV/CardDAV sync (services.caldav). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The CalDAV/CardDAV sync (services.caldav), as DAVx⁵'s: Android's calendar and contacts, which the build grants
         when services.caldav is on; the sync framework's settings of Nixup's own accounts; and the tasks apps it syncs
         with (Tasks.org, OpenTasks, jtx Board), whose permissions the build grants when they are installed. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.READ_SYNC_STATS" />
    <uses-permission android:name="org.dmfs.permission.READ_TASKS" />
    <uses-permission android:name="org.dmfs.permission.WRITE_TASKS" />
    <uses-permission android:name="org.tasks.permission.READ_TASKS" />
    <uses-permission android:name="org.tasks.permission.WRITE_TASKS" />
    <uses-permission android:name="at.techbee.jtx.permission.READ" />
    <uses-permission android:name="at.techbee.jtx.permission.WRITE" />

    <!-- The apps that open a folder (the Files app, file managers), for Open config folder. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.document/directory" />
        </intent>
        <!-- The tasks apps the sync writes tasks into (their content providers). -->
        <provider android:authorities="org.dmfs.tasks" />
        <provider android:authorities="org.tasks.opentasks" />
        <provider android:authorities="at.techbee.jtx.provider" />
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">
        <!-- The app's own look (res/values/themes.xml); with a search box's keyboard up, the screen leaves it room. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Nixup"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The terminal: root's shell in Nixup's view, with the config's Nix packages. -->
        <activity
            android:name=".terminal.TerminalActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="false"
            android:label="@string/terminal"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- Google's sign-in page, for the account Google Play's apps come with. -->
        <activity
            android:name=".GoogleSignInActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode"
            android:exported="false"
            android:label="@string/google_sign_in_title"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".terminal.TerminalService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Terminal sessions the user started, kept running while the terminal is closed" />
        </service>

        <!-- What the module's engine (as root) tells: not exported, so no other app can. -->
        <receiver
            android:name=".EventsReceiver"
            android:exported="false" />

        <!-- The buttons of services.ntfy's messages that the app does itself: an HTTP request, a broadcast, a copy. -->
        <receiver
            android:name=".NtfyActionReceiver"
            android:exported="false" />

        <!-- UnifiedPush (services.ntfy.unifiedPush): Nixup as a distributor other apps (Element, ...) can pick, which they
             ask for an endpoint and find by this receiver; and its link activity. Off until the ntfy service turns them
             on (see UnifiedPush.kt). -->
        <receiver
            android:name=".UnifiedPushReceiver"
            android:enabled="false"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="org.unifiedpush.android.distributor.REGISTER" />
                <action android:name="org.unifiedpush.android.distributor.UNREGISTER" />
                <action android:name="org.unifiedpush.android.distributor.MESSAGE_ACK" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".UnifiedPushLinkActivity"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:host="link"
                    android:scheme="unifiedpush" />
            </intent-filter>
        </activity>

        <service
            android:name=".UpdateJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".BackupJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- The CalDAV/CardDAV sync (services.caldav), as DAVx⁵'s: Nixup's account type, with Android's sync adapters
             for the calendars and the tasks apps; and the address books' account type, with the contacts' adapter. -->
        <service
            android:name=".dav.sync.account.AccountAuthenticatorService"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/dav_account_authenticator" />
        </service>
        <service
            android:name=".dav.sync.adapter.CalendarsSyncAdapterService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/dav_sync_calendars" />
        </service>
        <service
            android:name=".dav.sync.adapter.OpenTasksSyncAdapterService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/dav_sync_opentasks" />
        </service>
        <service
            android:name=".dav.sync.adapter.TasksOrgSyncAdapterService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/dav_sync_tasks_org" />
        </service>
        <service
            android:name=".dav.sync.adapter.JtxSyncAdapterService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/dav_sync_jtx" />
        </service>
        <!-- (Exported, as in DAVx⁵: Google Contacts shows the address books only then, since Android 11.) -->
        <service
            android:name=".dav.sync.account.AddressBookAuthenticatorService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/dav_account_authenticator_address_book" />
        </service>
        <service
            android:name=".dav.sync.adapter.ContactsSyncAdapterService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/dav_sync_contacts" />
            <meta-data
                android:name="android.provider.CONTACTS_STRUCTURE"
                android:resource="@xml/dav_contacts" />
        </service>
    </application>
</manifest>
