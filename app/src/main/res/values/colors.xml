<?xml version="1.0" encoding="utf-8"?>
<!-- How an event went, in the Logs tab and the notifications: done, failed, a warning, news, running; and what a
     search found in a log. -->
<resources>
    <color name="level_ok">#2E7D32</color>
    <color name="level_error">#C62828</color>
    <color name="level_warn">#B26A00</color>
    <color name="level_info">#1565C0</color>
    <color name="level_start">#6A1B9A</color>
    <!-- The sign on an event's round mark (✓, ✕, !): white on the dark marks of the light theme. -->
    <color name="on_level">#FFFFFF</color>
    <color name="search_match">#66FFD54F</color>

    <!-- The main screen's own colors: the night blue of the icon for what can be pressed and the tab shown, its flame
         for news (an update, Nixup's own), on a light background with white cards. -->
    <color name="background">#F4F5FA</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_variant">#E9EBF4</color>
    <color name="outline">#DCDFEB</color>
    <color name="text_secondary">#5A5E70</color>
    <color name="primary">#3F4BB0</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="primary_container">#DFE2FF</color>
    <color name="on_primary_container">#121A5C</color>
    <color name="flame_container">#FFE9DB</color>
    <color name="on_flame_container">#4A1D00</color>
    <color name="console">#ECEEF6</color>
    <!-- A button that waits (while a script runs), and what a press shows on each kind of button. -->
    <color name="disabled">#1F1B1C24</color>
    <color name="ripple_filled">#33FFFFFF</color>
    <color name="ripple_tonal">#293F4BB0</color>
    <!-- The small counts on the tabs: updates waiting, and problems in the last day (white on them, in both themes). -->
    <color name="badge_news">#C2410C</color>
    <color name="badge_problem">#B3261E</color>
</resources>
