<?xml version="1.0" encoding="utf-8"?>
<!-- The bar at the top (the app's name, the terminal and the menu), five tabs' panes, and the tabs at the bottom.
     Build: the config and the last build, each a card, over what a build says. Updates, Backups, Services and Logs: a
     card with the tab's state and buttons, over its list, which has a search box. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <!-- The bar, with a line under it that moves while a script runs. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:logo="@drawable/ic_logo_bar"
            android:title="@string/app_name"
            android:titleTextAppearance="@style/TextAppearance.Nixup.AppTitle" />

        <ProgressBar
            android:id="@+id/busy"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:indeterminate="true"
            android:indeterminateTint="@color/primary"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:visibility="invisible" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/build_pane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp">

            <!-- The config: where it is, and another picked. -->
            <LinearLayout
                style="@style/Widget.Nixup.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/config"
                        android:textAppearance="@style/TextAppearance.Nixup.Overline" />

                    <Button
                        android:id="@+id/open_folder"
                        style="@style/Widget.Nixup.Button.Plain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-12dp"
                        android:layout_marginEnd="-8dp"
                        android:layout_marginBottom="-8dp"
                        android:text="@string/open_folder" />
                </LinearLayout>

                <TextView
                    android:id="@+id/source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/source_none"
                    android:textAppearance="@style/TextAppearance.Nixup.Title"
                    android:textIsSelectable="true" />

                <!-- A config from a git repository: its clone, and what it does with it. -->
                <LinearLayout
                    android:id="@+id/git_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/git_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Nixup.Secondary"
                        android:textIsSelectable="true" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/git_pull"
                            style="@style/Widget.Nixup.Button.Plain"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/git_pull" />

                        <Button
                            android:id="@+id/git_pull_build"
                            style="@style/Widget.Nixup.Button.Plain"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/git_pull_build" />

                        <Button
                            android:id="@+id/git_reclone"
                            style="@style/Widget.Nixup.Button.Plain"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/git_reclone" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/pick_file"
                        style="@style/Widget.Nixup.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingHorizontal="4dp"
                        android:text="@string/pick_file" />

                    <Button
                        android:id="@+id/new_config"
                        style="@style/Widget.Nixup.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:paddingHorizontal="4dp"
                        android:text="@string/new_config" />

                    <Button
                        android:id="@+id/git_source"
                        style="@style/Widget.Nixup.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:paddingHorizontal="4dp"
                        android:text="@string/git_source" />

                    <Button
                        android:id="@+id/type_source"
                        style="@style/Widget.Nixup.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:paddingHorizontal="4dp"
                        android:text="@string/type_source" />
                </LinearLayout>
            </LinearLayout>

            <!-- The last build, and building again. -->
            <LinearLayout
                style="@style/Widget.Nixup.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/last_build_label"
                        android:textAppearance="@style/TextAppearance.Nixup.Overline" />

                    <Button
                        android:id="@+id/generations"
                        style="@style/Widget.Nixup.Button.Plain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-12dp"
                        android:layout_marginEnd="-8dp"
                        android:layout_marginBottom="-8dp"
                        android:text="@string/generations" />
                </LinearLayout>

                <TextView
                    android:id="@+id/last_build"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Nixup.Large" />

                <TextView
                    android:id="@+id/last_build_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.Nixup.Secondary"
                    android:textIsSelectable="true"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/build"
                        style="@style/Widget.Nixup.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/build" />

                    <Button
                        android:id="@+id/dry_run"
                        style="@style/Widget.Nixup.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/dry_run" />

                    <Button
                        android:id="@+id/upgrade"
                        style="@style/Widget.Nixup.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/upgrade" />
                </LinearLayout>
            </LinearLayout>

            <ScrollView
                android:id="@+id/scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_console">

                <TextView
                    android:id="@+id/output"
                    style="@style/Widget.Nixup.Console"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="@string/output_hint"
                    android:textColorHint="@color/text_secondary" />
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/updates_pane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:visibility="gone">

            <LinearLayout
                style="@style/Widget.Nixup.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/updates_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Nixup.Secondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/check_updates"
                        style="@style/Widget.Nixup.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/check_updates" />

                    <Button
                        android:id="@+id/update_all"
                        style="@style/Widget.Nixup.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/update_all" />
                </LinearLayout>
            </LinearLayout>

            <!-- A newer Nixup, when there is one (the module's update.json). -->
            <LinearLayout
                android:id="@+id/nixup_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_flame"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_logo" />

                <TextView
                    android:id="@+id/nixup_update_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Nixup.Title"
                    android:textColor="@color/on_flame_container" />

                <Button
                    android:id="@+id/nixup_update_install"
                    style="@style/Widget.Nixup.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/nixup_install" />
            </LinearLayout>

            <SearchView
                android:id="@+id/updates_search"
                style="@style/Widget.Nixup.Search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:queryHint="@string/search_updates" />

            <ScrollView
                android:id="@+id/updates_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:id="@+id/updates_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/updates_output"
                        style="@style/Widget.Nixup.Console"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:visibility="gone" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/backups_pane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:visibility="gone">

            <LinearLayout
                style="@style/Widget.Nixup.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/backups_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Nixup.Secondary"
                    android:textIsSelectable="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/backup_all"
                        style="@style/Widget.Nixup.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/backup_all" />

                    <Button
                        android:id="@+id/backup_pick"
                        style="@style/Widget.Nixup.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/backup_pick" />

                    <Button
                        android:id="@+id/backups_refresh"
                        style="@style/Widget.Nixup.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/refresh" />
                </LinearLayout>
            </LinearLayout>

            <SearchView
                android:id="@+id/backups_search"
                style="@style/Widget.Nixup.Search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:queryHint="@string/search_backups" />

            <ScrollView
                android:id="@+id/backups_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:id="@+id/backups_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/backups_output"
                        style="@style/Widget.Nixup.Console"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:visibility="gone" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/services_pane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:visibility="gone">

            <LinearLayout
                style="@style/Widget.Nixup.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/services_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/services_note"
                    android:textAppearance="@style/TextAppearance.Nixup.Secondary" />

                <Button
                    android:id="@+id/services_refresh"
                    style="@style/Widget.Nixup.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:text="@string/refresh" />
            </LinearLayout>

            <SearchView
                android:id="@+id/services_search"
                style="@style/Widget.Nixup.Search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:queryHint="@string/search_services" />

            <ScrollView
                android:id="@+id/services_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:id="@+id/services_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/services_output"
                        style="@style/Widget.Nixup.Console"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:visibility="gone" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/logs_pane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:visibility="gone">

            <LinearLayout
                style="@style/Widget.Nixup.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- How the last day went; with problems, a tap shows them. -->
                <LinearLayout
                    android:id="@+id/logs_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/logs_status_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:id="@+id/logs_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Nixup.Body" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/logs_refresh"
                        style="@style/Widget.Nixup.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/logs_refresh" />

                    <Button
                        android:id="@+id/logs_files"
                        style="@style/Widget.Nixup.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/logs_files" />
                </LinearLayout>
            </LinearLayout>

            <SearchView
                android:id="@+id/logs_search"
                style="@style/Widget.Nixup.Search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:queryHint="@string/search_logs" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/logs_filters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <ScrollView
                android:id="@+id/logs_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/logs_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="12dp" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- The tabs (made in MainActivity), over the navigation bar; gone while the keyboard is up. -->
    <LinearLayout
        android:id="@+id/tab_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/outline" />

        <LinearLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </LinearLayout>
</LinearLayout>
