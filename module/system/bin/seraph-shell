#!/system/bin/sh
# seraph-shell: root's shell, or a command, in Seraph's view of the phone, where /nix exists and the config's
# environment.systemPackages are on PATH, as on any Linux with Nix. The app's terminal opens it, and an ssh session
# (services.openssh) gets the same one (/etc/seraph/login, which the engine writes):
#   su -c seraph-shell             a login shell (bash, when the config has Nix packages)
#   su -c 'seraph-shell htop'      one command
# The view is the one Seraph's services run in (Android's folders as they are, Seraph's /etc, /var and /run, a /tmp
# of its own); Android's own commands are on PATH too, after the config's. Before the config's first build there is
# no view yet: an interactive shell is then Android's own.
DATA=/data/adb/seraph
[ "$(id -u)" = 0 ] || { echo "seraph-shell: run it as root: su -c seraph-shell" >&2; exit 1; }
busybox=
for b in /data/adb/magisk/busybox /data/adb/ksu/bin/busybox /data/adb/ap/bin/busybox; do
  [ -x "$b" ] && busybox=$b && break
done
# su -c gives its shell the terminal but not as its controlling one, without which a shell has no job control (and
# Ctrl+C reaches nothing): a session of its own takes it (busybox's setsid -c does; toybox's leaves it to another
# session). su's shell leads its process group, which cannot start a session, so a child of it does, and it waits.
if [ -t 0 ] && [ -z "$SERAPH_SHELL_TTY" ] && [ -n "$busybox" ] && ! (: < /dev/tty) 2> /dev/null; then
  export SERAPH_SHELL_TTY=1
  "$busybox" setsid -c /system/bin/sh "$0" "$@"
  exit $?
fi
if [ ! -f "$DATA/units/view.sh" ]; then
  [ $# -gt 0 ] && { echo "seraph-shell: build the config once first (Seraph makes its view then)" >&2; exit 1; }
  echo "seraph-shell: the config was not built yet, so this is Android's shell, without Nix packages" >&2
  cd "$DATA/home" 2> /dev/null || cd /
  exec /system/bin/sh -l
fi
quoted() { printf " '%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
script=$DATA/tmp/seraph-shell.$$
mkdir -p "$DATA/tmp"
{
  printf "export TERM='%s'\n" "${TERM:-xterm-256color}"
  # Root's shell, as the engine wrote it for the profile in place.
  echo 'if [ -x /etc/seraph/login ]; then'
  if [ $# -gt 0 ]; then
    printf "  exec /etc/seraph/login -c 'exec \"\$0\" \"\$@\"'"
    for word; do quoted "$word"; done
    echo
  else
    echo '  exec /etc/seraph/login'
  fi
  echo 'fi'
  # An engine from before /etc/seraph/login: the profile's PATH and bash (none without environment.systemPackages).
  path=$(grep -o '"shell":{[^}]*}' "$DATA/profile.json" 2> /dev/null | grep -o '"path":"[^"]*"' | cut -d'"' -f4)
  bash=$(grep -o '"shell":{[^}]*}' "$DATA/profile.json" 2> /dev/null | grep -o '"bash":"[^"]*"' | cut -d'"' -f4)
  printf "export PATH='%s' HOME='%s'\n" "${path:-/system/bin}" "$DATA/home"
  echo "cd /"
  if [ $# -gt 0 ]; then
    printf 'exec'
    for word; do quoted "$word"; done
    echo
  else
    echo "exec ${bash:-/system/bin/sh} -i"
  fi
} > "$script"
"$busybox" sh "$DATA/units/view.sh" "$script"
status=$?
rm -f "$script"
exit $status
