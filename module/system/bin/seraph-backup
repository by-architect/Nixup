#!/system/bin/sh
# seraph-backup: the backups of the config's apps and folders (android.backup), by hand, as root:
#   seraph-backup list [app or folder]        the backups there are
#   seraph-backup status                      when each app and folder was backed up last, and whether it is due
#   seraph-backup now [apps or folders]       back up now: all of them, or the ones named
#   seraph-backup restore <app> [snapshot]    the app's data back from its newest backup (or the one named, from
#                                             list), over what it has
#   seraph-backup restic <arguments>          restic itself, with the repository and password (snapshots, check,
#                                             restore <id> --target /data/local/tmp/x, ...)
# The phone backs them up by itself too, as the config says (android.backup.defaults.when).
[ "$(id -u)" = 0 ] || { echo "seraph-backup: run it as root: su -c seraph-backup" >&2; exit 1; }
d=/data/adb/modules_update/seraph
[ -f "$d/backup.sh" ] || d=/data/adb/modules/seraph
case "$1" in
  list | status | now | restore | restic) ;;
  "" | -h | --help | help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) echo "seraph-backup: no such command: $1 (list, status, now, restore, restic)" >&2; exit 1 ;;
esac
exec sh "$d/backup.sh" shell "$@"
